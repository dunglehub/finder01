          $('a-date').placeholder = ev ? 'for example Dec 5, 2026' : 'for example May 2027';
        }
        $('a-kind').addEventListener('change', syncKindLabels);
        $('a-cancel').addEventListener('click', closeAdd);
        $('add-open').addEventListener('click', openAdd);
        if (API) $('add-open').classList.add('show');
        // ---- "Fill it in": link or pasted text -> title, company, location, start date ----
        var NO_AUTO = /^https?:\/\/([\w-]+\.)*(indeed|linkedin|glassdoor)\.(com|ca)(\/|$|\?)/i;
        function cleanUrl(u) {
          try {
            var x = new URL(u);
            Array.from(x.searchParams.keys()).forEach(function (k) { if (/^(utm_|gclid|fbclid|from$|refid$|ref$|source$|src$|trk)/i.test(k)) x.searchParams.delete(k); });
            x.hash = ''; return x.toString();
          } catch (e) { return u; }
        }
        $('a-fill').addEventListener('click', function () {
          var input = $('a-source').value.trim(), st = $('a-fill-status'), btn = $('a-fill');
          if (!input) { st.textContent = 'Paste a link or the posting text first.'; return; }
          var isLink = /^https?:\/\/\S+$/i.test(input);
          if (isLink && NO_AUTO.test(input)) {
            $('a-url').value = cleanUrl(input);
            st.textContent = 'Indeed, LinkedIn and Glassdoor cannot be read from a link. Open the posting, press Ctrl+A then Ctrl+C, and paste the text here. I kept the link.';
            return;
          }
          btn.disabled = true; st.textContent = 'Reading… (a few seconds)';
          fetch(API + '/extract', { method: 'POST', cache: 'no-store', headers: { 'Content-Type': 'application/json', 'X-Passcode': pass }, body: JSON.stringify({ input: input }) })
            .then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok, status: r.status, d: d }; }); })
            .then(function (res) {
              if (res.status === 401) { closeAdd(); logout('Your passcode was not accepted. Please log in again.'); return; }
              if (!res.ok) {
                if (res.d && res.d.url && !$('a-url').value) $('a-url').value = res.d.url;
                st.textContent = (res.d && res.d.error) || 'Could not read that. Fill the fields in by hand.'; return;
              }
              var d = res.d;
              if (d.title) $('a-title').value = d.title;
              if (d.company) $('a-company').value = d.company;
              if (d.location) $('a-loc').value = d.location;
              if (d.start) $('a-date').value = d.start;
              if (d.url) $('a-url').value = d.url;
              else if (isLink) $('a-url').value = cleanUrl(input);
              $('a-kind').value = 'job'; syncKindLabels();
              addDesc = d.description || '';
              var missing = [];
              if (!$('a-url').value) missing.push('the link');
              if (!$('a-date').value) missing.push('start date');
              if (!$('a-loc').value) missing.push('location');
              st.textContent = 'Filled in. Please check it' + (missing.length ? ' and add ' + missing.join(', ') : '') + ', then click + Shortlist.';
            })
            .catch(function () { st.textContent = 'Could not reach the server. Fill the fields in by hand.'; })
            .then(function () { btn.disabled = false; });
        });
        $('add-form').addEventListener('submit', function (e) {
          e.preventDefault();
          var body = {
            kind: $('a-kind').value, title: $('a-title').value.trim(), url: $('a-url').value.trim(),
            company: $('a-company').value.trim(), location: $('a-loc').value.trim(),
            date: $('a-date').value.trim(), note: $('a-note').value.trim(), desc: addDesc, by: who,
          };
          if (!body.title) { $('a-err').textContent = 'Please add a title.'; return; }
          var btn = $('a-save'); btn.disabled = true; btn.textContent = 'Adding...';
          fetch(API + '/posts', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Passcode': pass }, body: JSON.stringify(body) })
            .then(function (r) {
              return r.json().catch(function () { return {}; }).then(function (d) { return { status: r.status, d: d }; });
            })
            .then(function (res) {
              if (res.status === 401) { closeAdd(); logout('Your passcode was not accepted. Please log in again.'); return; }
              if (res.status !== 200 || !res.d.post) { $('a-err').textContent = res.d.error || 'Could not add it. Please try again.'; return; }
              posts.unshift(res.d.post); lsSet('cf_posts', JSON.stringify(posts));
              marks[res.d.post.id] = { state: 'shortlist', by: who, ts: res.d.post.ts }; saveLocal();
              rebuildJobs(); tab = 'shortlist'; renderAll(); closeAdd();
              showView('jobs');
            })
            .catch(function () { $('a-err').textContent = 'Could not reach the shared list. Please try again.'; })
            .then(function () { btn.disabled = false; btn.textContent = '+ Shortlist'; });
        });

        // ---- Word (.docx) text, read in the browser so only plain text is sent ----
        function inflateRaw(bytes) {
