            var method = dv.getUint16(p + 10, true), csize = dv.getUint32(p + 20, true);
            var nl = dv.getUint16(p + 28, true), el2 = dv.getUint16(p + 30, true), cl = dv.getUint16(p + 32, true), off = dv.getUint32(p + 42, true);
            var name = new TextDecoder().decode(u8.subarray(p + 46, p + 46 + nl));
            if (name === 'word/document.xml') { hit = { method: method, csize: csize, off: off }; break; }
            p += 46 + nl + el2 + cl;
          }
          if (!hit) return Promise.reject(new Error('nodoc'));
          var ln = dv.getUint16(hit.off + 26, true), le = dv.getUint16(hit.off + 28, true), start = hit.off + 30 + ln + le;
          var data = u8.subarray(start, start + hit.csize);
          var raw = hit.method === 0 ? Promise.resolve(data.slice().buffer) : inflateRaw(data);
          return raw.then(function (ab) {
            var xml = new TextDecoder().decode(ab);
            return xml.replace(/<w:tab\b[^>]*\/>/g, '\t').replace(/<w:(br|cr)\b[^>]*\/>/g, '\n').replace(/<\/w:p>/g, '\n')
              .replace(/<[^>]+>/g, '').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&apos;/g, "'").replace(/&amp;/g, '&')
              .replace(/[ \t]+/g, ' ').replace(/ *\n */g, '\n').replace(/\n{3,}/g, '\n\n').trim();
          });
        }

        // ---- resume facts: upload, check, save ----
        var FACT_KEYS = ['education', 'skills', 'experience', 'projects', 'awards'];
        var MAX_RESUME_BYTES = 4 * 1024 * 1024;
        var resumeFile = '';
        function toLines(s) { return String(s || '').split('\n').map(function (x) { return x.trim(); }).filter(Boolean); }
        function fillFacts(f) {
          f = f || {};
          $('r-about').value = f.about || '';
          FACT_KEYS.forEach(function (k) { $('r-' + k).value = (f[k] || []).join('\n'); });
          $('r-edit').hidden = false; $('r-save').hidden = false;
        }
        function readFacts() {
          var f = { about: $('r-about').value.trim() };
          FACT_KEYS.forEach(function (k) { f[k] = toLines($('r-' + k).value); });
          return f;
        }
        function bufToBase64(buf) {
          var u8 = new Uint8Array(buf), s = '';
          for (var i = 0; i < u8.length; i += 0x8000) s += String.fromCharCode.apply(null, u8.subarray(i, i + 0x8000));
          return btoa(s);
        }
        function closeResume() { var d = $('resume-dialog'); if (d.close) d.close(); else d.removeAttribute('open'); }
        function resumeHeaders() { return { 'Content-Type': 'application/json', 'X-Passcode': pass }; }
        function openResume() {
          if (!pass) { openSetup(openResume); return; }
          $('r-file').value = ''; $('r-err').textContent = ''; resumeFile = '';
          $('r-status').textContent = 'Checking for saved facts…';
          $('r-edit').hidden = true; $('r-save').hidden = true; $('r-delete').hidden = true; $('r-read').disabled = false; $('r-save').disabled = false;
          var dlg = $('resume-dialog'); if (dlg.showModal) dlg.showModal(); else dlg.setAttribute('open', '');
          fetch(API + '/facts', { cache: 'no-store', headers: { 'X-Passcode': pass } })
            .then(function (r) { if (r.status === 401) throw new Error('401'); return r.ok ? r.json() : {}; })
            .then(function (d) {
              if (d && d.facts) {
                fillFacts(d.facts); $('r-delete').hidden = false; resumeFile = d.facts.file || '';
                var when2 = d.facts.ts ? new Date(d.facts.ts).toLocaleDateString('en-CA', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
                $('r-status').textContent = 'Saved' + (d.facts.file ? ' from ' + d.facts.file : '') + (when2 ? ' on ' + when2 : '') + '. Upload a new resume to replace it, or edit the lines and Save.';
              } else {
                $('r-status').textContent = 'No resume saved yet. Choose a file and click Read it.';
              }
            })
            .catch(function (e) {
              if (e && e.message === '401') { closeResume(); logout('Your passcode was not accepted. Please log in again.'); return; }
              $('r-status').textContent = 'Could not check for saved facts. You can still upload a resume.';
            });
        }
        $('r-close').addEventListener('click', closeResume);
        $('r-read').addEventListener('click', function () {
          var f = $('r-file').files && $('r-file').files[0], st = $('r-status'), btn = $('r-read');
          $('r-err').textContent = '';
          if (!f) { st.textContent = 'Choose your resume file first.'; return; }
          var nm = f.name.toLowerCase(), isPdf = /\.pdf$/.test(nm), isDocx = /\.docx$/.test(nm);
          if (/\.doc$/.test(nm)) { st.textContent = 'Old .doc files are not supported. In Word, use Save As and pick .docx (or PDF).'; return; }
          if (!isPdf && !isDocx) { st.textContent = 'Please choose a PDF or a .docx file.'; return; }
          if (f.size > MAX_RESUME_BYTES) { st.textContent = 'That file is over 4 MB. Please use a smaller one.'; return; }
          btn.disabled = true; st.textContent = 'Reading… (about 10 to 20 seconds)';
          f.arrayBuffer().then(function (buf) {
            if (isPdf) return { kind: 'pdf', filename: f.name, data: bufToBase64(buf) };
            return docxText(buf).then(function (t) { return { kind: 'text', filename: f.name, text: t }; });
          }).then(function (payload) {
            return fetch(API + '/resume', { method: 'POST', cache: 'no-store', headers: resumeHeaders(), body: JSON.stringify(payload) })
              .then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok, status: r.status, d: d }; }); })
              .then(function (res) {
                if (res.status === 401) { closeResume(); logout('Your passcode was not accepted. Please log in again.'); return; }
                if (!res.ok || !res.d.facts) { st.textContent = (res.d && res.d.error) || 'Could not read that file.'; return; }
                resumeFile = f.name; fillFacts(res.d.facts);
                st.textContent = 'Read. Check every line against your resume, fix anything wrong or missing, then click Save. Nothing is saved yet.' + (res.d.left != null ? ' ' + res.d.left + ' AI uses left today.' : '');
              });
          }).catch(function (e) {
            st.textContent = e && (e.message === 'notzip' || e.message === 'nodoc')
              ? 'I could not open that Word file. Try saving it as a PDF instead.'
              : 'Could not read or send that file. Please try again.';
          }).then(function () { btn.disabled = false; });
        });
        $('r-save').addEventListener('click', function () {
          var btn = $('r-save'); btn.disabled = true; $('r-err').textContent = '';
          fetch(API + '/facts', { method: 'POST', cache: 'no-store', headers: resumeHeaders(), body: JSON.stringify({ file: resumeFile, facts: readFacts() }) })
            .then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok, status: r.status, d: d }; }); })
            .then(function (res) {
              if (res.status === 401) { closeResume(); logout('Your passcode was not accepted. Please log in again.'); return; }
              if (!res.ok) { $('r-err').textContent = (res.d && res.d.error) || 'Could not save. Please try again.'; return; }
              $('r-status').textContent = 'Saved. AI letters will now use only these facts.'; $('r-delete').hidden = false;
            })
            .catch(function () { $('r-err').textContent = 'Could not reach the server. Please try again.'; })
            .then(function () { btn.disabled = false; });
        });
        $('r-delete').addEventListener('click', function () {
          if (!confirm('Delete your saved resume facts? AI letters will go back to the public profile.')) return;
          fetch(API + '/facts', { method: 'DELETE', cache: 'no-store', headers: { 'X-Passcode': pass } })
            .then(function (r) {
              if (r.status === 401) { closeResume(); logout('Your passcode was not accepted. Please log in again.'); return; }
              if (!r.ok) throw new Error('HTTP ' + r.status);
              $('r-edit').hidden = true; $('r-save').hidden = true; $('r-delete').hidden = true; resumeFile = '';
              $('r-status').textContent = 'Deleted. Choose a file and click Read it to start again.';
            })
            .catch(function () { $('r-err').textContent = 'Could not delete right now. Please try again.'; });
        });

        // ---- top bar: user menu, Clear, filters box ----
        $('chip').addEventListener('click', function (e) {
          e.stopPropagation();
          if (API && who) { var m = $('menu'); m.hidden = !m.hidden; $('chip').setAttribute('aria-expanded', m.hidden ? 'false' : 'true'); }
          else openSetup(null);
        });
        document.addEventListener('click', function (e) { if (!e.target.closest('.usermenu')) { $('menu').hidden = true; $('chip').setAttribute('aria-expanded', 'false'); } });
        $('menu-resume').addEventListener('click', function () { $('menu').hidden = true; openResume(); });
        $('menu-logout').addEventListener('click', function () { $('menu').hidden = true; logout(); });
        $('clear-top').addEventListener('click', function () { $('clear').click(); });
        $('fbox').open = !isNarrow();

        // ---- top-level tabs ----
        function showView(v) {
          if (v !== 'jobs' && v !== 'bc' && v !== 'else') v = 'jobs';
          var secs = document.querySelectorAll('.view');
          for (var i = 0; i < secs.length; i++) secs[i].hidden = secs[i].getAttribute('data-view') !== v;
          $('sidejobs').hidden = v !== 'jobs'; $('app').classList.remove('show-detail');
          var nb = $('nav').querySelectorAll('button');
          for (var k = 0; k < nb.length; k++) nb[k].setAttribute('aria-pressed', nb[k].getAttribute('data-view') === v ? 'true' : 'false');
        }
        $('nav').addEventListener('click', function (e) {
          var b = e.target.closest('button[data-view]');
          if (!b) return;
          var v = b.getAttribute('data-view');
          showView(v);
          try { history.replaceState(null, '', '#' + v); } catch (err) {}
        });
        $('home').addEventListener('click', function () {
          tab = 'review'; $('clear').click(); showView('jobs');
          $('menu').hidden = true;
          try { history.replaceState(null, '', location.pathname + location.search); } catch (err) {}
          renderAll(); window.scrollTo(0, 0);
        });
        ['b-upd', 'b-pol'].forEach(function (id) {
          var e = document.getElementById(id), d = e && new Date(e.getAttribute('data-iso'));
          if (d && !isNaN(d)) e.textContent = d.toLocaleString('en-CA', { dateStyle: 'medium', timeStyle: 'short' });
        });
        showView((location.hash || '').slice(1));

        renderAll();
        syncDown();
        document.addEventListener('visibilitychange', function () { if (!document.hidden) syncDown(); });
        if (API) setInterval(function () { if (!document.hidden) syncDown(); }, 120000);
      })();
    </script>
  </body>
</html>
