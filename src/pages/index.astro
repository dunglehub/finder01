---
import autoJobs from '../../data/jobs.json';
import manualJobs from '../../data/manual-jobs.json';
import watchlist from '../../data/watchlist.json';
import config from '../../data/config.json';
import profile from '../../data/profile.json';
import companies from '../../data/companies.json';
import status from '../../data/status.json';
import { enrich } from '../../scripts/lib/classify.mjs';

// Manual jobs are enriched the same way as automatic ones, then tagged "hand-picked".
const manual = manualJobs.map((j) =>
  enrich({ ...j, source: 'manual', description: `${j.start ? 'Starting ' + j.start + '. ' : ''}${j.note || ''}` }),
);
const jobs = [...manual, ...autoJobs];

const fmt = (iso) => iso ? new Date(iso).toLocaleString('en-CA', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'America/Edmonton' }) : '';
const updatedText = fmt(status.updated);
const polledText = fmt(status.polled);

const bcList = watchlist.filter((c) => c.region === 'BC');
const elseList = watchlist.filter((c) => c.region !== 'BC');

// Simple coloured letter badge instead of company logos.
const initial = (name) => (name.match(/[A-Za-z]/) || ['?'])[0].toUpperCase();
const hue = (name) => [...name].reduce((h, ch) => (h * 31 + ch.charCodeAt(0)) % 360, 7);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1" />
    <title>Co-op Finder: Summer 2027</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />
    <meta name="description" content="Intern and co-op roles in battery, EV and clean-energy engineering, starting May 2027." />
    <style is:global>
      :root {
        --navy: #1f2530; --blue: #4f5c93; --blue-soft: #e7eaf5; --green: #2f8a57; --green-soft: #e1f0e6;
        --amber: #9a5b1e; --amber-soft: #f8e9d3; --grey: #6b6f78; --grey-soft: #e9e6df; --red: #b3372f;
        --bg: #f2f0eb; --bg2: #f8f7f3; --card: #ffffff; --text: #1f2530; --muted: #6b6f78; --line: #dcd9d1;
        --shadow: 0 1px 2px rgba(31,37,48,.05);
        --radius: 12px;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --navy: #eceae4; --blue: #93a4dc; --blue-soft: #2a3252; --green: #6cc596; --green-soft: #1f3a2c;
          --amber: #e2b072; --amber-soft: #3a2f1c; --grey: #a2a5ad; --grey-soft: #2d3038; --red: #ef9a94;
          --bg: #181a1f; --bg2: #1f2228; --card: #23262d; --text: #eceae4; --muted: #a2a5ad; --line: #343841;
          --shadow: 0 1px 2px rgba(0,0,0,.4);
        }
      }
      [hidden] { display: none !important; }
      html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
      html, body { margin: 0; max-width: 100%; overflow-x: hidden; overflow-x: clip; touch-action: pan-y pinch-zoom; }
      body { position: relative; width: 100%; }
      .app { width: 100%; max-width: 100%; overflow-x: clip; }
      .addbtn .long { display: inline; }
      body { color: var(--text); background: var(--bg); font: 15px/1.5 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
      button, input, select, textarea { font-family: inherit; }
      button:focus-visible, input:focus-visible, select:focus-visible, summary:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }

      /* ---------- top bar ---------- */
      .app { min-height: 100vh; display: flex; flex-direction: column; }
      .top { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 24px;
        border-bottom: 1px solid var(--line); background: var(--bg); position: sticky; top: 0; z-index: 20; }
      .brand { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; min-width: 0; }
      .home { font: inherit; color: inherit; background: none; border: none; padding: 4px 6px; margin: -4px -6px; cursor: pointer; letter-spacing: inherit; font-weight: inherit; border-radius: 8px; }
      .home:hover { background: var(--grey-soft); }
      .brand h1 { margin: 0; font-size: 1.5rem; font-weight: 600; letter-spacing: -.01em; }
      .live { display: inline-flex; align-items: center; gap: 7px; font-size: .88rem; font-weight: 600; color: var(--green); }
      .live i { width: 9px; height: 9px; border-radius: 50%; background: var(--green); }
      .live.offline { color: var(--red); } .live.offline i { background: var(--red); }
      .live.locked, .live.connecting, .live.local { color: var(--muted); } .live.locked i, .live.connecting i, .live.local i { background: var(--grey); }
      .topright { display: flex; align-items: center; gap: 10px; }
      .linkbtn { font: inherit; font-size: .92rem; background: none; border: none; color: var(--blue); cursor: pointer;
        padding: 6px 8px; display: inline-flex; align-items: center; gap: 6px; }
      .linkbtn:hover { text-decoration: underline; }
      #clear-top, #clear { font-weight: 700; }
      .addbtn { font: inherit; font-weight: 600; font-size: .92rem; display: none; align-items: center; gap: 6px; padding: 5px 11px;
        border-radius: 9px; cursor: pointer; border: none; color: #fff; background: var(--blue); }
      .addbtn.show { display: inline-flex; }
      .addbtn:hover { filter: brightness(1.08); }
      .usermenu { position: relative; }
      .chip { display: inline-flex; align-items: center; gap: 9px; padding: 5px 14px 5px 6px; border-radius: 12px; border: 1px solid var(--line);
        background: var(--card); font-size: .92rem; color: var(--text); cursor: pointer; }
      .chip:not(:has(.avatar)) { padding-left: 14px; }
      .chip .avatar { width: 28px; height: 28px; border-radius: 50%; font-size: .85rem; }
      .menu { position: absolute; right: 0; top: calc(100% + 6px); background: var(--card); border: 1px solid var(--line); border-radius: 10px;
        box-shadow: 0 10px 30px rgba(0,0,0,.15); min-width: 170px; padding: 6px; z-index: 30; }
      .menu button { display: block; width: 100%; text-align: left; background: none; border: none; padding: 9px 12px; border-radius: 8px;
        font: inherit; color: var(--text); cursor: pointer; }
      .menu button:hover { background: var(--grey-soft); }
      .flash { margin: 10px 24px 0; padding: 8px 12px; border-radius: 10px; background: var(--amber-soft); color: var(--amber); font-size: .9rem; }

      /* ---------- layout ---------- */
      .layout { flex: 1; display: grid; grid-template-columns: 262px minmax(0, 1fr); align-items: start; }
      .side { padding: 18px 16px 24px 20px; border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 14px;
        position: sticky; top: 64px; max-height: calc(100vh - 64px); overflow: auto; }
      .sep { height: 1px; background: var(--line); }
      .nav { display: flex; flex-direction: column; gap: 4px; }
      .nav button { display: flex; align-items: center; gap: 10px; width: 100%; text-align: left; padding: 9px 12px; border-radius: 10px;
        border: none; background: none; font: inherit; color: var(--text); cursor: pointer; }
      .nav button:hover { background: var(--grey-soft); }
      .nav button .ico { color: var(--muted); font-size: 1.15rem; flex: none; }
      .nav button .cnt { margin-left: auto; color: var(--muted); font-size: .85rem; }
      .nav button[aria-pressed=true] { background: var(--grey-soft); font-weight: 600; }
      #sidejobs { display: flex; flex-direction: column; gap: 14px; }
      .pills { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
      .pills button { display: flex; justify-content: space-between; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 10px;
        border: 1px solid var(--line); background: var(--card); font: inherit; font-size: .9rem; color: var(--text); cursor: pointer; }
      .pills button .ico { display: none; }
      .pills button .n { color: var(--muted); font-weight: 600; }
      .pills button:hover { border-color: var(--muted); }
      .pills button[aria-pressed=true] { border-color: var(--blue); background: var(--blue-soft); font-weight: 600; }
      .progress { display: flex; align-items: center; gap: 10px; font-size: .8rem; color: var(--muted); flex-wrap: wrap; }
      .progress .bar { flex: 1 1 100%; height: 6px; border-radius: 999px; background: var(--grey-soft); overflow: hidden; }
      .progress .bar i { display: block; height: 100%; width: 0; background: var(--green); transition: width .3s; }
      .fbox > summary { display: none; cursor: pointer; font-weight: 600; padding: 4px 0 10px; }
      .search { position: relative; }
      .search .ico { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: var(--muted); font-size: 1.05rem; }
      .search input { width: 100%; padding: 9px 12px 9px 34px; border-radius: 10px; border: 1px solid var(--line); background: var(--card); color: var(--text); font: inherit; }
      .fchecks { display: flex; flex-direction: column; gap: 6px; margin-top: 12px; }
      .chk { display: flex; align-items: center; gap: 9px; padding: 7px 10px; border: 1px solid var(--line); border-radius: 10px;
        background: var(--card); font-size: .88rem; cursor: pointer; }
      .chk input { accent-color: var(--blue); width: 16px; height: 16px; margin: 0; flex: none; }
      .fchecks .num { display: inline-block; min-width: 1.4em; text-align: center; font-weight: 700; font-size: .74rem; color: var(--muted);
        background: var(--grey-soft); border-radius: 999px; padding: 1px 6px; flex: none; }
      .fbox .linkbtn { margin-top: 8px; padding-left: 2px; }
      .built { color: var(--muted); font-size: .78rem; margin: 0; }
      .main { padding: 18px 22px 40px; min-width: 0; }
      .cols { display: grid; grid-template-columns: minmax(300px, 410px) minmax(0, 1fr); gap: 18px; align-items: start; }
      .listcol { min-width: 0; }
      .listhead { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; margin: 0 2px 10px; color: var(--muted); font-size: .88rem; }
      .listhead label { display: inline-flex; align-items: center; gap: 8px; }
      .listhead select { padding: 6px 10px; border-radius: 10px; border: 1px solid var(--line); background: var(--card); color: var(--text); font: inherit; font-size: .88rem; }
      #list { display: flex; flex-direction: column; gap: 10px; max-height: calc(100vh - 140px); overflow: auto; padding: 2px 4px 4px 2px; }

      /* ---------- job cards ---------- */
      .card { display: grid; grid-template-columns: 34px minmax(0, 1fr); gap: 2px 12px; background: var(--card); border: 1px solid var(--line);
        border-radius: 12px; padding: 12px 14px; cursor: pointer; box-shadow: var(--shadow); }
      .card:hover { border-color: var(--muted); }
      .card.sel { border-color: var(--text); box-shadow: 0 0 0 1px var(--text); }
      .card[data-state=skip] { opacity: .72; }
      .avatar { width: 34px; height: 34px; border-radius: 8px; display: grid; place-items: center; font-weight: 700; font-size: 1rem; color: #fff; flex: none; }
      .card .avatar { background: var(--grey-soft) !important; color: var(--text); }
      .card h3 { margin: 0; font-size: 1rem; font-weight: 700; line-height: 1.3; }
      .meta { color: var(--muted); font-size: .88rem; margin-top: 1px; }
      .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
      .tag { font-size: .74rem; font-weight: 600; padding: 2px 9px; border-radius: 999px; background: var(--grey-soft); color: var(--muted);
        display: inline-flex; align-items: center; gap: 4px; }
      .tag.warn { background: var(--amber-soft); color: var(--amber); }
      .tag.info { background: var(--blue-soft); color: var(--blue); }
      .tag.match { background: var(--blue-soft); color: var(--blue); }
      .tag.match.strong { background: var(--blue-soft); color: var(--blue); }
      .tag .ico { font-size: .9em; }
      .why { margin: 8px 0 0; font-size: .8rem; color: var(--muted); }
      .note { margin: 8px 0 0; font-size: .86rem; color: var(--text); opacity: .88;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .who { font-size: .78rem; color: var(--muted); }
      .actions { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-top: 10px; }
      .actions button { font: inherit; font-size: .8rem; font-weight: 500; display: inline-flex; align-items: center; gap: 5px;
        padding: 5px 11px; border-radius: 8px; cursor: pointer; border: 1px solid var(--line); background: var(--card); color: var(--text); }
      .actions button:hover { border-color: var(--muted); }
      .actions button.on-shortlist { background: var(--amber-soft); border-color: var(--amber); color: var(--amber); }
      .actions button.on-applied { background: var(--blue-soft); border-color: var(--blue); color: var(--blue); }
      .actions button.on-skip { background: var(--grey-soft); border-color: var(--grey); color: var(--grey); }
      .rm { font: inherit; font-size: .8rem; background: none; border: none; color: var(--muted); cursor: pointer; padding: 5px 4px; margin-left: auto; }
      .rm:hover { color: var(--red); text-decoration: underline; }

      /* ---------- detail panel ---------- */
      .detail { position: sticky; top: 82px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; display: flex; flex-direction: column;
        max-height: calc(100vh - 106px); min-width: 0; }
      .detail .dbody { padding: 22px 26px 8px; overflow: auto; flex: 1; }
      .detail h2 { font-size: 1.7rem; font-weight: 500; line-height: 1.2; margin: 0 0 6px; letter-spacing: -.01em; }
      .detail .dsub { color: var(--muted); }
      .detail hr { border: none; border-top: 1px solid var(--line); margin: 16px 0; }
      .detail .drow { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 10px; margin-bottom: 8px; }
      .detail .dlabel { font-weight: 600; }
      .detail .dval { word-break: break-word; }
      .exp-toggle { display: flex; justify-content: space-between; align-items: center; width: 100%; background: none; border: none; padding: 0;
        font: inherit; font-weight: 600; color: var(--text); cursor: pointer; }
      .exp-toggle .ico { transition: transform .15s; }
      .exp-toggle[aria-expanded=false] .ico { transform: rotate(180deg); }
      .exp ul { margin: 10px 0 0; padding-left: 20px; }
      .exp li { margin-bottom: 4px; }
      .exp details { margin-top: 10px; }
      .exp summary { cursor: pointer; color: var(--blue); font-size: .9rem; }
      .exp .full { margin-top: 8px; max-height: 240px; overflow: auto; white-space: pre-wrap; font-size: .88rem; color: var(--muted);
        background: var(--bg2); border-radius: 8px; padding: 10px 12px; }
      .detail .dbar { border-top: 1px solid var(--line); padding: 12px 18px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
      .detail .dbar .actions { margin: 0; }
      .detail .dbar .actions button { font-size: .86rem; padding: 7px 13px; }
      .detail .dbar .spacer { flex: 1; }
      .btn2 { display: inline-block; text-decoration: none; font-size: .86rem; padding: 7px 13px; border-radius: 8px; border: 1px solid var(--line); background: var(--card); color: var(--text); }
      .btn2:hover { border-color: var(--muted); }
      .btn1 { font: inherit; font-weight: 600; font-size: .9rem; padding: 8px 16px; border-radius: 8px; border: none; background: var(--blue); color: #fff; cursor: pointer; }
      .btn1:hover { filter: brightness(1.08); }
      .detail .ph { padding: 40px 26px; color: var(--muted); }
      .dback { display: none; font: inherit; background: none; border: none; color: var(--blue); cursor: pointer; padding: 0 0 12px; }

      @media (max-width: 960px) {
        .top { padding: 10px 12px; position: static; gap: 8px; }
        .brand { gap: 4px 10px; flex: 1 1 auto; min-width: 0; }
        .brand h1 { font-size: 1.05rem; line-height: 1.2; }
        .live { font-size: .8rem; }
        .topright { gap: 4px; flex: 0 0 auto; }
        .linkbtn { padding: 6px 6px; font-size: .85rem; }
        .addbtn { padding: 4px 9px; font-size: .85rem; border-radius: 8px; gap: 4px; }
        .addbtn .long { display: none; }
        .addbtn .ico { width: 14px; height: 14px; }
        .chip { padding: 3px 10px 3px 4px; font-size: .82rem; }
        .chip .avatar { width: 24px; height: 24px; font-size: .75rem; }
        .layout { grid-template-columns: minmax(0, 1fr); }
        .side, .main, .listcol, .cols, .app { min-width: 0; max-width: 100%; }
        .pills { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .nav { max-width: 100%; }
        .side { position: static; max-height: none; border-right: none; border-bottom: 1px solid var(--line); padding: 14px; }
        .nav { flex-direction: row; overflow-x: auto; }
        .nav { gap: 2px; overflow-x: visible; }
        .nav button { white-space: nowrap; width: auto; padding: 8px 9px; gap: 5px; font-size: .92rem; }
        .nav button .ico { display: none; }
        .fbox > summary { display: block; }
        .main { padding: 14px; }
        .cols { grid-template-columns: minmax(0, 1fr); }
        #list { max-height: none; overflow: visible; }
        .detail { display: none; position: static; max-height: none; }
        .dback { display: inline-block; }
        .app.show-detail .side, .app.show-detail .listcol { display: none; }
        .app.show-detail .detail { display: flex; }
        .flash { margin: 10px 14px 0; }
      }
      @media (max-width: 560px) {
        .app { overflow-x: clip; }
        .top { flex-wrap: wrap; padding: 8px 10px; gap: 4px 6px; }
        .brand { flex: 1 1 auto; gap: 2px 8px; }
        .brand h1 { font-size: 1rem; }
        .live { font-size: .72rem; gap: 5px; }
        .live i { width: 7px; height: 7px; }
        .brand { flex: 1 1 100%; }
        .topright { gap: 4px; flex: 1 1 100%; justify-content: space-between; max-width: 100%; min-width: 0; }
        .linkbtn { padding: 4px 5px; font-size: .78rem; }
        .addbtn { padding: 3px 7px; font-size: .78rem; border-radius: 7px; gap: 3px; }
        .addbtn .ico { width: 12px; height: 12px; }
        .chip { padding: 2px 8px 2px 3px; font-size: .78rem; gap: 5px; }
        .chip:not(:has(.avatar)) { padding-left: 8px; }
        .chip .avatar { width: 20px; height: 20px; font-size: .68rem; }
        .flash { margin: 8px 10px 0; padding: 6px 10px; font-size: .82rem; }
        .side { padding: 10px; gap: 10px; }
        .main { padding: 10px 10px 28px; }
        .nav button { padding: 5px 7px; gap: 4px; font-size: .84rem; }
        .nav button .cnt { font-size: .76rem; }
        .pills { gap: 6px; }
        .pills button { padding: 5px 9px; font-size: .84rem; border-radius: 8px; }
        .progress { font-size: .74rem; }
        .listhead { font-size: .8rem; margin: 0 0 8px; }
        .listhead select { padding: 4px 8px; font-size: .8rem; }
        #list { padding: 0; gap: 8px; }
        .card { grid-template-columns: 28px minmax(0, 1fr); gap: 2px 9px; padding: 9px 10px; border-radius: 10px; }
        .avatar { width: 28px; height: 28px; font-size: .88rem; border-radius: 7px; }
        .card h3 { font-size: .95rem; }
        .meta { font-size: .8rem; }
        .tag { font-size: .7rem; padding: 1px 7px; }
        .tags { gap: 4px; margin-top: 6px; }
        .actions { gap: 4px; margin-top: 8px; }
        .actions button { font-size: .76rem; padding: 4px 8px; border-radius: 7px; }
        .detail .dbody { padding: 14px 12px 6px; }
        .detail .dbar { padding: 10px 12px; gap: 6px; }
        .tip { padding: 10px 12px; gap: 10px; margin-top: 16px; font-size: .88rem; }
        .tip .ico { font-size: 1.3rem; }
      }
      @media (max-width: 960px) { input, select, textarea, .listhead select, dialog input, dialog textarea, dialog select { font-size: 16px !important; } }
      @media (max-width: 560px) { .detail .drow { grid-template-columns: 1fr; gap: 2px; } .detail h2 { font-size: 1.4rem; } .detail .dbody { padding: 18px 16px 8px; } }

      /* ---------- kept from before ---------- */
      * { box-sizing: border-box; }
      svg { display: block; }
      .ico { display: inline-flex; vertical-align: middle; }
      .ico svg { width: 1em; height: 1em; }
      /* ---------- header ---------- */
      /* ---------- top navigation ---------- */
      /* ---------- filters ---------- */
      #add-dialog { width: min(520px, calc(100vw - 32px)); }
      #add-dialog .two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      #add-dialog #a-source { min-height: 70px; }
      #a-fill, #prep-ai-btn { white-space: nowrap; flex: 0 0 auto; }
      #add-dialog textarea { width: 100%; min-height: 78px; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--line);
        background: var(--bg2); color: var(--text); font: inherit; resize: vertical; }
      #add-dialog select { width: 100%; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--line); background: var(--bg2); color: var(--text); font: inherit; }
      @media (max-width: 480px) { #add-dialog .two { grid-template-columns: 1fr; } }
      #emp-dialog { width: min(480px, calc(100vw - 32px)); }
      #emp-dialog textarea { width: 100%; min-height: 70px; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--line);
        background: var(--bg2); color: var(--text); font: inherit; resize: vertical; }
      #emp-dialog select { width: 100%; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--line); background: var(--bg2); color: var(--text); font: inherit; }
      .emptools { margin: 0 0 14px; }
      .co .actions .rm + .rm { margin-left: 0; }
      .hid { margin-top: 18px; border: 1px dashed var(--line); border-radius: 12px; padding: 8px 14px; }
      .hid summary { cursor: pointer; color: var(--muted); font-size: .92rem; }
      .hidrow { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-top: 1px solid var(--line); margin-top: 8px; }
      .hidrow span { flex: 1; font-weight: 600; }
      .hidrow button { font: inherit; font-size: .88rem; padding: 6px 12px; border-radius: 10px; cursor: pointer; border: 1px solid var(--line); background: var(--bg2); color: var(--text); }
      #resume-dialog { width: min(640px, calc(100vw - 32px)); max-height: calc(100vh - 32px); overflow: auto; }
      #resume-dialog textarea { width: 100%; min-height: 128px; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--line);
        background: var(--bg2); color: var(--text); font: inherit; resize: vertical; }
      #resume-dialog .pick { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-top: 10px; }
      #resume-dialog .pick input[type=file] { width: auto; flex: 1 1 220px; padding: 8px; }
      #resume-dialog .hint { color: var(--muted); font-size: .86rem; margin: 2px 0 0; }
      #r-read { white-space: nowrap; flex: 0 0 auto; }
      /* ---------- job cards ---------- */
      #prep-dialog { width: min(680px, calc(100vw - 32px)); max-height: calc(100vh - 32px); overflow: auto; }
      #prep-dialog textarea { width: 100%; min-height: 300px; padding: 12px; border-radius: 10px; border: 1px solid var(--line);
        background: var(--bg2); color: var(--text); font: inherit; line-height: 1.5; resize: vertical; }
      #prep-dialog #prep-desc { min-height: 90px; }
      #prep-dialog .qa { display: grid; grid-template-columns: 150px 1fr auto; gap: 8px; align-items: center; padding: 8px 0; border-top: 1px solid var(--line); font-size: .92rem; }
      #prep-dialog .qa .k { color: var(--muted); }
      #prep-dialog .qa .v { word-break: break-word; }
      #prep-dialog .warnbox { background: var(--amber-soft); color: var(--amber); border-radius: 10px; padding: 8px 12px; font-size: .88rem; margin: 8px 0 12px; }
      #prep-dialog a.btnlink { display: inline-block; text-decoration: none; padding: 9px 18px; border-radius: 10px; background: var(--blue); color: #fff; font-weight: 600; }
      @media (max-width: 520px) { #prep-dialog .qa { grid-template-columns: 1fr auto; } #prep-dialog .qa .k { grid-column: 1 / -1; } }
      .empty { padding: 34px 20px; text-align: center; color: var(--muted); background: var(--bg2);
        border: 1px dashed var(--line); border-radius: var(--radius); }
      .empty .big { width: 64px; height: 64px; margin: 0 auto 8px; color: var(--blue); opacity: .85; }
      .empty .big svg { width: 100%; height: 100%; }
      .empty strong { display: block; color: var(--navy); font-size: 1.05rem; margin-bottom: 2px; }
      /* ---------- employers ---------- */
      .view[hidden] { display: none; }
      .view h2 { font-size: 1.25rem; margin: 4px 0 4px; }
      .sub { color: var(--muted); margin: 0 0 16px; font-size: .95rem; max-width: 46em; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 12px; }
      .co { background: var(--bg2); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px;
        display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 4px 12px; min-width: 0; }
      .co > div { min-width: 0; }
      .co p, .co a { overflow-wrap: anywhere; word-break: break-word; }
      .co .avatar { width: 44px; height: 44px; font-size: 1.2rem; border-radius: 12px; }
      .co a { font-weight: 700; color: var(--navy); text-decoration: none; }
      .co a:hover { color: var(--blue); text-decoration: underline; }
      .co p { margin: 2px 0 0; font-size: .88rem; color: var(--muted); }
      .co .actions { grid-column: 1 / -1; margin-top: 8px; }
      /* ---------- tip ---------- */
      .tip { display: flex; gap: 14px; align-items: flex-start; margin-top: 26px; padding: 16px 18px; border-radius: var(--radius);
        background: var(--blue-soft); border: 1px solid var(--line); }
      .tip .ico { font-size: 1.7rem; color: var(--blue); flex: none; margin-top: 2px; }
      .tip p { margin: 0; }
      .tip p:first-child { font-weight: 400; color: var(--text); }
      .tip p + p { color: var(--muted); font-size: .92rem; }
      /* ---------- dialog ---------- */
      dialog { border: 1px solid var(--line); border-radius: 18px; background: var(--card); color: var(--text);
        padding: 22px; width: min(420px, calc(100vw - 32px)); box-shadow: 0 20px 60px rgba(0,0,0,.3); }
      dialog::backdrop { background: rgba(15,42,74,.5); }
      dialog h3 { margin: 0 0 6px; }
      dialog label { display: block; margin: 12px 0 4px; font-size: .9rem; color: var(--muted); }
      dialog input { width: 100%; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--line);
        background: var(--bg2); color: var(--text); font: inherit; }
      dialog .row { display: flex; gap: 8px; justify-content: flex-end; margin-top: 18px; }
      dialog button { font: inherit; padding: 9px 18px; border-radius: 10px; cursor: pointer;
        border: 1px solid var(--line); background: var(--bg2); color: var(--text); }
      dialog button.primary { background: var(--blue); border-color: var(--blue); color: #fff; font-weight: 600; }
      dialog .err { color: var(--red); font-size: .88rem; min-height: 1.2em; margin-top: 8px; }
    </style>
  </head>
  <body>
    <main class="app" id="app" data-api={config.api || ''}>
      <header class="top">
        <div class="brand">
          <h1><button type="button" class="home" id="home" title="Back to the start">Co-op</button></h1>
          <span class="live locked" id="live"><i></i><b>Live</b></span>
        </div>
        <div class="topright">
          <button type="button" class="linkbtn" id="clear-top" title="Untick all filters and empty the search box">Reset filters</button>
          <button type="button" class="addbtn" id="add-open"><span class="ico" data-i="plus"></span><span class="lbl">Post</span></button>
          <div class="usermenu">
            <button type="button" class="chip" id="chip" aria-haspopup="true" aria-expanded="false"></button>
            <div class="menu" id="menu" hidden>
              <button type="button" id="menu-resume">My resume</button>
              <button type="button" id="menu-logout">Log out</button>
            </div>
          </div>
        </div>
      </header>
      <div class="flash" id="status" role="status" hidden></div>

      <div class="layout">
        <aside class="side">
          <nav class="nav" id="nav" aria-label="Sections">
            <button type="button" data-view="jobs" aria-pressed="true"><span class="ico" data-i="briefcase"></span>Jobs <span class="cnt" id="jobs-count">{jobs.length}</span></button>
            <button type="button" data-view="bc" aria-pressed="false"><span class="ico" data-i="people"></span>Employers <span class="cnt" id="cnt-bc">{bcList.length}</span></button>
            <button type="button" data-view="else" aria-pressed="false"><span class="ico" data-i="pin"></span>Elsewhere <span class="cnt" id="cnt-else">{elseList.length}</span></button>
          </nav>
          <div id="sidejobs">
            <div class="sep"></div>
            <div class="pills" id="tabs" role="group" aria-label="Show postings">
              <button type="button" data-tab="review" aria-pressed="true"><span class="ico" data-i="refresh"></span>Review <span class="n"></span></button>
              <button type="button" data-tab="shortlist" aria-pressed="false"><span class="ico" data-i="star"></span>Shortlist <span class="n"></span></button>
              <button type="button" data-tab="applied" aria-pressed="false"><span class="ico" data-i="check"></span>Applied <span class="n"></span></button>
              <button type="button" data-tab="skip" aria-pressed="false"><span class="ico" data-i="x"></span>Skipped <span class="n"></span></button>
            </div>
            <div class="progress" id="progress"><span id="progress-text"></span><span class="bar"><i id="progress-bar"></i></span></div>
            <div class="sep"></div>
            <details class="fbox" id="fbox" open>
              <summary>Filters</summary>
              <div class="search">
                <span class="ico" data-i="search"></span>
                <input type="search" id="q" placeholder="Search" aria-label="Search jobs" />
              </div>
              <div class="fchecks" id="fchecks" role="group" aria-label="Filters, in order of priority (tick one or more to narrow the list)"></div>
              <button type="button" class="linkbtn" id="clear" hidden>Reset filters</button>
            </details>
          </div>
          <p class="built">Updated <span id="b-upd" data-iso={status.updated}>{updatedText}</span>{polledText && <><br />Indeed and others polled <span id="b-pol" data-iso={status.polled}>{polledText}</span></>}</p>
        </aside>

        <div class="main">
          <section class="view" data-view="jobs">
            <div class="cols">
              <div class="listcol">
                <div class="listhead">
                  <span id="count"></span>
                  <label>Sort by
                    <select id="sort" aria-label="Sort by">
                      <option value="priority">Priority</option>
                      <option value="best">Best match</option>
                      <option value="new">Newest</option>
                      <option value="company">Company</option>
                    </select>
                  </label>
                </div>
                <div id="list"></div>
              </div>
              <div class="detail" id="detail" aria-live="polite"></div>
            </div>
          </section>

        <section class="view" data-view="bc" hidden>
          <h2>Employers</h2>
          <p class="sub">These sites can't be pulled automatically, so each link goes straight to their careers page. Search for "intern" or "co-op". Use the buttons to keep track of the ones you've looked at. These are the BC ones.</p>
          <div class="emptools"><button type="button" class="addbtn" data-emp-add="BC"><span class="ico" data-i="plus"></span>Employer</button></div>
          <div class="grid">
            {bcList.map((c) => (
              <div class="co" data-id={`co:${c.name}`}>
                <div class="avatar" style={`background:linear-gradient(135deg,hsl(${hue(c.name)} 70% 52%),hsl(${(hue(c.name) + 40) % 360} 65% 38%))`}>{initial(c.name)}</div>
                <div>
                  <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>
                  {c.mode === 'auto' && <span class="tag good" style="margin-left:6px">auto</span>}
                  <p>{c.note}</p>
                </div>
              </div>
            ))}
          </div>
          <details class="hid" id="hid-bc" hidden><summary>Hidden (<span class="n">0</span>)</summary><div class="hidlist"></div></details>
        </section>

        <section class="view" data-view="else" hidden>
          <h2>Elsewhere</h2>
          <p class="sub">Employers outside BC. Same idea: open the careers page and search for "intern" or "co-op".</p>
          <div class="emptools"><button type="button" class="addbtn" data-emp-add="Elsewhere"><span class="ico" data-i="plus"></span>Employer</button></div>
          <div class="grid">
            {elseList.map((c) => (
              <div class="co" data-id={`co:${c.name}`}>
                <div class="avatar" style={`background:linear-gradient(135deg,hsl(${hue(c.name)} 70% 52%),hsl(${(hue(c.name) + 40) % 360} 65% 38%))`}>{initial(c.name)}</div>
                <div>
                  <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>
                  <p>{c.note}</p>
                </div>
              </div>
            ))}
          </div>
          <details class="hid" id="hid-else" hidden><summary>Hidden (<span class="n">0</span>)</summary><div class="hidlist"></div></details>
        </section>

          <div class="tip">
        <span class="ico" data-i="bulb"></span>
        <div>
          <p>Jobs come from employers with public job feeds. Many sites have no feed or need a login, so check them under Employers. UBC's co-op portal needs your login too.</p>
          <p>Confirm dates on the posting.</p>
        </div>
      </div>
        </div>
      </div>
    </main>

    <dialog id="setup">
      <form method="dialog" id="setup-form">
        <h3>Log in</h3>
        <p class="who" style="margin:0" id="s-help">Enter your own passcode. Your name then shows next to what you mark.</p>
        <label for="s-name" id="s-name-label">Your name or nickname</label>
        <input id="s-name" maxlength="30" autocomplete="off" />
        <label for="s-pass" id="s-pass-label">Your passcode</label>
        <input id="s-pass" type="password" autocomplete="current-password" />
        <div class="err" id="s-err"></div>
        <div class="row">
          <button type="button" id="s-cancel">Cancel</button>
          <button type="submit" class="primary" id="s-save">Log in</button>
        </div>
      </form>
    </dialog>

    <dialog id="prep-dialog">
      <h3 id="prep-title">Prepare application</h3>
      <div class="warnbox">Draft only. Read it, fix anything that is not true for you, then paste it into the application.</div>
      <label for="prep-letter">Cover letter</label>
      <textarea id="prep-letter"></textarea>
      <div class="row" style="justify-content:flex-start;margin-top:8px"><button type="button" id="prep-copy-letter">Copy letter</button></div>
      <div id="prep-ai" hidden>
        <label for="prep-desc">Job description (optional: paste it here for a better AI letter)</label>
        <textarea id="prep-desc" maxlength="8000"></textarea>
        <div class="row" style="justify-content:flex-start;align-items:center;margin-top:8px">
          <button type="button" class="primary" id="prep-ai-btn">Write with AI</button>
          <span class="who" id="prep-ai-status" role="status"></span>
        </div>
      </div>
      <label style="margin-top:16px">Quick answers</label>
      <div id="prep-qa"></div>
      <div class="row">
        <button type="button" id="prep-close">Close</button>
        <a class="btnlink" id="prep-open" href="#" target="_blank" rel="noopener noreferrer">Open posting</a>
      </div>
    </dialog>

    <dialog id="resume-dialog">
      <h3>Your resume facts</h3>
      <p class="who" style="margin:0">Upload your resume (PDF or Word). The AI lists what it says, you check and fix the list, then Save. AI letters use only this list.</p>
      <div class="pick">
        <input type="file" id="r-file" accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" aria-label="Resume file" />
        <button type="button" class="primary" id="r-read">Read it</button>
      </div>
      <p class="hint">PDF or .docx, up to 4 MB. Old .doc files: in Word, use Save As and pick .docx.</p>
      <div class="who" id="r-status" role="status" style="margin-top:8px"></div>
      <div id="r-edit" hidden>
        <label for="r-about">About</label>
        <textarea id="r-about" maxlength="800"></textarea>
        <label for="r-education">Education (one per line)</label>
        <textarea id="r-education"></textarea>
        <label for="r-skills">Skills (one per line)</label>
        <textarea id="r-skills"></textarea>
        <label for="r-experience">Experience (one per line)</label>
        <textarea id="r-experience"></textarea>
        <label for="r-projects">Projects (one per line)</label>
        <textarea id="r-projects"></textarea>
        <label for="r-awards">Awards (one per line)</label>
        <textarea id="r-awards"></textarea>
      </div>
      <div class="err" id="r-err"></div>
      <div class="row">
        <button type="button" id="r-delete" hidden>Delete saved facts</button>
        <button type="button" id="r-close">Close</button>
        <button type="button" class="primary" id="r-save" hidden>Save</button>
      </div>
    </dialog>

    <dialog id="emp-dialog">
      <form method="dialog" id="emp-form">
        <h3>Add employer</h3>
        <p class="who" style="margin:0">A careers page to check directly. It shows up for everyone.</p>
        <label for="e-name">Company name</label>
        <input id="e-name" maxlength="100" autocomplete="off" required />
        <label for="e-url">Careers link</label>
        <input id="e-url" type="url" placeholder="https://..." autocomplete="off" required />
        <label for="e-region">Where is it?</label>
        <select id="e-region"><option value="BC">BC</option><option value="Elsewhere">Elsewhere</option></select>
        <label for="e-note">Note (optional)</label>
        <textarea id="e-note" maxlength="300"></textarea>
        <div class="err" id="e-err"></div>
        <div class="row">
          <button type="button" id="e-cancel">Cancel</button>
          <button type="submit" class="primary" id="e-save">Add employer</button>
        </div>
      </form>
    </dialog>

    <dialog id="add-dialog">
      <form method="dialog" id="add-form">
        <h3>Add a posting for Benny</h3>
        <p class="who" style="margin:0">A job or an event you found. It goes straight into the Shortlist for everyone.</p>
        <div id="a-auto">
          <label for="a-source">Paste a link and the form fills itself in</label>
          <textarea id="a-source" maxlength="60000" placeholder="Paste the job link here. For Indeed or LinkedIn, press Ctrl+A then Ctrl+C on the posting page and paste the text instead."></textarea>
          <div class="row" style="justify-content:flex-start;align-items:center;margin-top:8px">
            <button type="button" class="primary" id="a-fill">Fill it in</button>
            <span class="who" id="a-fill-status" role="status"></span>
          </div>
        </div>
        <label for="a-kind">Type</label>
        <select id="a-kind"><option value="job">Job or co-op</option><option value="event">Event to register for</option></select>
        <label for="a-title">Title *</label>
        <input id="a-title" maxlength="150" autocomplete="off" required />
        <label for="a-url">Link *</label>
        <input id="a-url" type="url" placeholder="https://..." autocomplete="off" required />
        <div class="two">
          <div><label for="a-company">Company or organizer</label><input id="a-company" maxlength="100" autocomplete="off" /></div>
          <div><label for="a-loc">Location</label><input id="a-loc" maxlength="100" autocomplete="off" /></div>
        </div>
        <label for="a-date" id="a-date-label">Start date (optional)</label>
        <input id="a-date" maxlength="40" placeholder="for example May 2027" autocomplete="off" />
        <label for="a-note">Note for Benny (optional)</label>
        <textarea id="a-note" maxlength="600"></textarea>
        <div class="err" id="a-err"></div>
        <div class="row">
          <button type="button" id="a-cancel">Cancel</button>
          <button type="submit" class="primary" id="a-save">+ Shortlist</button>
        </div>
      </form>
    </dialog>

    <script id="profile-data" type="application/json" set:html={JSON.stringify(profile)}></script>
    <script id="co-rank" type="application/json" set:html={JSON.stringify(companies.companies)}></script>
    <script id="emp-data" type="application/json" set:html={JSON.stringify(Object.fromEntries(watchlist.map((c) => [c.name, c.note || ''])))}></script>
    <script id="jobs-data" type="application/json" set:html={JSON.stringify(jobs)}></script>
    <script is:inline>
      (function () {
        var baseJobs = JSON.parse(document.getElementById('jobs-data').textContent);
        var jobs = baseJobs.slice();
        var posts = [];
        var EMP = {};
        try { EMP = JSON.parse(document.getElementById('emp-data').textContent) || {}; } catch (e) { EMP = {}; }
        var BATTERY_RE = /batter(y|ies)|energy storage|cell engineer|lithium|electric vehicle|\bEVs?\b|power ?pack/i;
        var MECH_RE = /mechanical|mechatronic|\bmech\.? eng/i;
        // Keyword tags: from the posting's own text, plus (for battery) what the employer does.
        function topicTags(j) {
          var own = [j.title, j.note, j.description].join(' ');
          return {
            battery: BATTERY_RE.test(own) || BATTERY_RE.test(EMP[j.company] || ''),
            mech: MECH_RE.test(own),
          };
        }
        // ---- match score: how well a posting fits the profile in data/profile.json ----
        var PROFILE = { interests: [], avoid: [] };
        try { PROFILE = JSON.parse(document.getElementById('profile-data').textContent) || PROFILE; } catch (e) { /* no profile */ }
        var RULES = [];
        (PROFILE.interests || []).concat(PROFILE.avoid || []).forEach(function (r) {
          try { RULES.push({ label: r.label, weight: r.weight, re: new RegExp(r.pattern, 'i') }); } catch (e) { /* bad pattern: skip */ }
        });
        // A keyword in the title counts in full; one only in the description or employer note counts half.
        function matchOf(j) {
          if (j.match) return j.match;
          var title = j.title || '';
          var rest = [j.note, j.description, j.company !== 'Event' ? (EMP[j.company] || '') : ''].join(' ');
          var total = 0, why = [];
          RULES.forEach(function (r) {
            var inTitle = r.re.test(title), inRest = r.re.test(rest);
            if (!inTitle && !inRest) return;
            var pts = inTitle ? r.weight : r.weight / 2;
            total += pts;
            if (pts > 0) why.push({ label: r.label, pts: pts });
          });
          why.sort(function (a, b) { return b.pts - a.pts; });
          j.match = {
            score: total,
            tier: total >= 6 ? 'strong' : total >= 3 ? 'good' : '',
            why: why.slice(0, 3).map(function (w) { return w.label; }),
          };
          return j.match;
        }
        function fitScore(j) { return matchOf(j).score + (j.bc ? 2 : 0); }

        var API = (document.getElementById('app').getAttribute('data-api') || '').replace(/\/$/, '');
        var $ = function (id) { return document.getElementById(id); };
        var list = $('list'), count = $('count');

        // ---- static icons (fixed strings, no user content) ----
        var P = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
        var ICONS = {
          briefcase: '<svg ' + P + '><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18"/></svg>',
          people: '<svg ' + P + '><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.6-3.6 3.2-5.5 6.5-5.5s5.9 1.9 6.5 5.5"/><circle cx="17.5" cy="9" r="2.5"/><path d="M17 14.5c2.6.1 4.3 1.6 4.8 4.5"/></svg>',
          pin: '<svg ' + P + '><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>',
          search: '<svg ' + P + '><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>',
          refresh: '<svg ' + P + '><path d="M20 11a8 8 0 0 0-14.3-4.3L4 8.5M4 4v4.5h4.5M4 13a8 8 0 0 0 14.3 4.3L20 15.5M20 20v-4.5h-4.5"/></svg>',
          star: '<svg ' + P + '><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3Z"/></svg>',
          check: '<svg ' + P + '><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>',
          x: '<svg ' + P + '><path d="M6 6l12 12M18 6 6 18"/></svg>',
          cal: '<svg ' + P + '><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>',
          bulb: '<svg ' + P + '><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3Z"/></svg>',
          plus: '<svg ' + P + '><path d="M12 5v14M5 12h14"/></svg>',
          chev: '<svg ' + P + '><path d="m6 15 6-6 6 6"/></svg>',
          empty: '<svg ' + P + '><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M9 14h6"/></svg>',
        };
        function icon(name) { var s = document.createElement('span'); s.className = 'ico'; s.innerHTML = ICONS[name] || ''; return s; }
        (function paintStatic() {
          var n = document.querySelectorAll('[data-i]');
          for (var i = 0; i < n.length; i++) n[i].innerHTML = ICONS[n[i].getAttribute('data-i')] || '';
        })();

        // ---- tiny safe wrappers around localStorage (it can be blocked) ----
        function lsGet(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
        function lsSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
