---
import autoJobs from '../../data/jobs.json';
import manualJobs from '../../data/manual-jobs.json';
import watchlist from '../../data/watchlist.json';
import config from '../../data/config.json';
import { enrich } from '../../scripts/lib/classify.mjs';

// Manual jobs are enriched the same way as automatic ones, then tagged "hand-picked".
const manual = manualJobs.map((j) =>
  enrich({ ...j, source: 'manual', description: `${j.start ? 'Starting ' + j.start + '. ' : ''}${j.note || ''}` }),
);
const jobs = [...manual, ...autoJobs];

const checked = new Date().toLocaleString('en-CA', {
  dateStyle: 'medium', timeStyle: 'short', timeZone: 'America/Vancouver',
});

const bcList = watchlist.filter((c) => c.region === 'BC');
const elseList = watchlist.filter((c) => c.region !== 'BC');

// Simple coloured letter badge instead of company logos.
const initial = (name) => (name.match(/[A-Za-z]/) || ['?'])[0].toUpperCase();
const hue = (name) => [...name].reduce((h, ch) => (h * 31 + ch.charCodeAt(0)) % 360, 7);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Co-op Finder: Summer 2027</title>
    <meta name="description" content="Intern and co-op roles in battery, EV and clean-energy engineering, starting May 2027." />
    <style is:global>
      :root {
        --navy: #0f2a4a; --blue: #2563eb; --blue-soft: #e8efff; --green: #059669; --green-soft: #dcf5ea;
        --amber: #b45309; --amber-soft: #fff1d0; --grey: #64748b; --grey-soft: #e9edf3; --red: #b91c1c;
        --bg: #eef3fa; --bg2: #f8fafd; --card: #ffffff; --text: #0f2a4a; --muted: #5b6b80; --line: #dde5f0;
        --shadow: 0 1px 2px rgba(15,42,74,.06), 0 6px 18px rgba(15,42,74,.07);
        --radius: 16px;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --navy: #e8f0ff; --blue: #6c9bff; --blue-soft: #1a2a4d; --green: #4fd8a2; --green-soft: #133a2c;
          --amber: #f3b861; --amber-soft: #3b2d12; --grey: #9fb0c5; --grey-soft: #263241; --red: #f19a9a;
          --bg: #0d141d; --bg2: #121b27; --card: #17212e; --text: #e8f0ff; --muted: #9fb0c5; --line: #26354a;
          --shadow: 0 1px 2px rgba(0,0,0,.4), 0 6px 18px rgba(0,0,0,.3);
        }
      }
      * { box-sizing: border-box; }
      body { margin: 0; color: var(--text);
        background: radial-gradient(1200px 500px at 15% -10%, var(--blue-soft), transparent 70%), var(--bg);
        background-attachment: fixed;
        font: 16px/1.5 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
      svg { display: block; }
      .ico { display: inline-flex; vertical-align: middle; }
      .ico svg { width: 1em; height: 1em; }

      .wrap { max-width: 980px; margin: 0 auto; padding: 22px 16px 56px; }

      /* ---------- header ---------- */
      .hero { position: relative; padding: 6px 0 4px; min-height: 120px; }
      .hero .art { position: absolute; right: -8px; top: 6px; width: min(36%, 340px); pointer-events: none; opacity: .95; }
      .hero .art svg { width: 100%; height: auto; }
      .title { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin: 0; }
      .title h1 { font-size: clamp(1.6rem, 4.6vw, 2.35rem); line-height: 1.1; margin: 0; letter-spacing: -.02em; }
      .title h1 em { font-style: normal; color: var(--blue); }
      .cap { width: 46px; height: 46px; color: var(--blue); flex: none; }
      .live { display: inline-flex; align-items: center; gap: 6px; font-size: .8rem; font-weight: 600; color: var(--green);
        background: var(--green-soft); padding: 4px 12px; border-radius: 999px; }
      .live i { width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 0 var(--green);
        animation: pulse 2s infinite; }
      @keyframes pulse { 70% { box-shadow: 0 0 0 7px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
      @media (prefers-reduced-motion: reduce) { .live i { animation: none; } }
      .lead { font-size: 1.08rem; margin: 10px 0 2px; max-width: 34em; }
      .built { color: var(--muted); font-size: .9rem; margin: 0; }
      .built .ico { margin-right: 4px; }
      @media (max-width: 820px) { .hero .art { display: none; } }

      /* ---------- top navigation ---------- */
      .nav { display: flex; flex-wrap: wrap; gap: 8px; margin: 22px 0 0; position: relative; z-index: 1; }
      .nav button { font: inherit; font-weight: 600; font-size: .95rem; display: inline-flex; align-items: center; gap: 8px;
        padding: 10px 18px; border-radius: 14px 14px 0 0; cursor: pointer; color: var(--muted);
        background: color-mix(in srgb, var(--card) 70%, transparent); border: 1px solid transparent; border-bottom: none; }
      .nav button:hover { color: var(--text); }
      .nav button[aria-pressed=true] { color: var(--blue); background: var(--card); border-color: var(--line);
        box-shadow: 0 -4px 14px rgba(15,42,74,.05); }
      .nav .cnt { font-size: .78rem; background: var(--grey-soft); color: var(--muted); padding: 1px 8px; border-radius: 999px; }
      .nav button[aria-pressed=true] .cnt { background: var(--blue-soft); color: var(--blue); }

      .panel { background: var(--card); border: 1px solid var(--line); border-radius: 0 var(--radius) var(--radius) var(--radius);
        box-shadow: var(--shadow); padding: 16px; margin-top: -1px; }
      @media (max-width: 640px) {
        .nav { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
        .nav button { white-space: nowrap; padding: 9px 12px; font-size: .88rem; flex: none; }
        .nav button > .ico { display: none; }
        .filters select, .chk, .linkbtn { flex: 1 1 auto; }
      }

      /* ---------- filters ---------- */
      .filters { display: flex; flex-wrap: wrap; gap: 10px 12px; align-items: center; }
      .search { position: relative; flex: 1 1 260px; min-width: 0; }
      .search .ico { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--muted); font-size: 1.1rem; }
      .search input { width: 100%; padding: 12px 14px 12px 42px; border-radius: 12px; border: 1px solid var(--line);
        background: var(--bg2); color: var(--text); font: inherit; }
      .search input:focus, select:focus-visible, button:focus-visible, dialog input:focus-visible {
        outline: 2px solid var(--blue); outline-offset: 2px; }
      .filters select { padding: 11px 12px; border-radius: 12px; border: 1px solid var(--line); background: var(--bg2);
        color: var(--text); font: inherit; }
      .chk { display: inline-flex; gap: 8px; align-items: center; font-size: .92rem; color: var(--text); cursor: pointer;
        padding: 9px 12px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg2); }
      .chk input { accent-color: var(--blue); width: 16px; height: 16px; }
      .linkbtn { font: inherit; font-size: .9rem; background: none; border: none; color: var(--blue); cursor: pointer;
        padding: 6px 4px; display: inline-flex; align-items: center; gap: 6px; }
      .linkbtn:hover { text-decoration: underline; }

      .pills { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; align-items: center; }
      .pills button { font: inherit; font-size: .92rem; font-weight: 600; display: inline-flex; align-items: center; gap: 7px;
        padding: 8px 16px; border-radius: 999px; cursor: pointer; color: var(--text); background: var(--bg2);
        border: 1px solid var(--line); }
      .pills button .n { font-weight: 500; opacity: .8; }
      .pills button[data-tab=review] .ico { color: var(--green); }
      .pills button[data-tab=shortlist] .ico { color: var(--amber); }
      .pills button[data-tab=applied] .ico { color: var(--blue); }
      .pills button[data-tab=skip] .ico { color: var(--grey); }
      .pills button[aria-pressed=true] { color: #fff; border-color: transparent; box-shadow: 0 4px 12px rgba(15,42,74,.2); }
      .pills button[aria-pressed=true] .ico { color: #fff; }
      .pills button[data-tab=review][aria-pressed=true] { background: linear-gradient(135deg, #10b981, #047857); }
      .pills button[data-tab=shortlist][aria-pressed=true] { background: linear-gradient(135deg, #f59e0b, #b45309); }
      .pills button[data-tab=applied][aria-pressed=true] { background: linear-gradient(135deg, #3b82f6, #1d4ed8); }
      .pills button[data-tab=skip][aria-pressed=true] { background: linear-gradient(135deg, #94a3b8, #64748b); }

      .progress { display: flex; align-items: center; gap: 10px; margin-top: 14px; font-size: .85rem; color: var(--muted); }
      .progress .bar { flex: 1; height: 8px; border-radius: 999px; background: var(--grey-soft); overflow: hidden; max-width: 260px; }
      .progress .bar i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #10b981, #3b82f6); transition: width .3s; }

      .status { color: var(--muted); font-size: .85rem; margin: 14px 2px 0; display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: center; }
      .status .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; background: var(--grey); }
      .status .dot.online { background: var(--green); }
      .status .dot.offline { background: var(--red); }
      .status .err { color: var(--red); }

      .listhead { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px;
        margin: 18px 2px 10px; color: var(--muted); font-size: .9rem; }
      .listhead label { display: inline-flex; align-items: center; gap: 8px; }
      .listhead select { padding: 7px 10px; border-radius: 10px; border: 1px solid var(--line); background: var(--bg2);
        color: var(--text); font: inherit; font-size: .9rem; }

      /* ---------- job cards ---------- */
      .card { display: grid; grid-template-columns: 56px 1fr; gap: 6px 16px; background: var(--card); border: 1px solid var(--line);
        border-left: 4px solid var(--green); border-radius: var(--radius); padding: 16px 18px; margin-bottom: 12px;
        box-shadow: var(--shadow); transition: transform .12s, box-shadow .12s; }
      .card:hover { transform: translateY(-1px); box-shadow: 0 2px 4px rgba(15,42,74,.08), 0 10px 26px rgba(15,42,74,.1); }
      .card[data-state=shortlist] { border-left-color: #f59e0b; }
      .card[data-state=applied] { border-left-color: #3b82f6; }
      .card[data-state=skip] { border-left-color: #94a3b8; opacity: .85; }
      .avatar { width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; font-weight: 800; font-size: 1.4rem;
        color: #fff; flex: none; }
      .card h3 { margin: 0; font-size: 1.12rem; line-height: 1.3; }
      .card h3 a { color: var(--navy); text-decoration: none; }
      .card h3 a:hover { color: var(--blue); text-decoration: underline; }
      .meta { color: var(--muted); font-size: .93rem; margin-top: 2px; display: flex; flex-wrap: wrap; gap: 2px 12px; align-items: center; }
      .meta .ico { margin-right: 4px; }
      .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
      .tag { font-size: .78rem; font-weight: 600; padding: 3px 10px; border-radius: 999px; background: var(--grey-soft); color: var(--muted);
        display: inline-flex; align-items: center; gap: 5px; }
      .tag.good { background: var(--green-soft); color: var(--green); }
      .tag.warn { background: var(--amber-soft); color: var(--amber); }
      .tag.info { background: var(--blue-soft); color: var(--blue); }
      .note { margin: 10px 0 0; font-size: .92rem; color: var(--text); opacity: .88;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .note.open { -webkit-line-clamp: unset; display: block; }
      .more { font: inherit; font-size: .84rem; background: none; border: none; color: var(--blue); cursor: pointer; padding: 0; margin-top: 2px; }

      .actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 12px; }
      .actions button { font: inherit; font-size: .88rem; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;
        padding: 7px 14px; border-radius: 10px; cursor: pointer; border: 1px solid var(--line); background: var(--bg2); color: var(--text);
        box-shadow: 0 1px 2px rgba(15,42,74,.06); }
      .actions button:hover { border-color: var(--muted); transform: translateY(-1px); }
      .actions button.on-shortlist { background: var(--amber-soft); border-color: #f59e0b; color: var(--amber); }
      .actions button.on-applied { background: var(--blue-soft); border-color: #3b82f6; color: var(--blue); }
      .actions button.on-skip { background: var(--grey-soft); border-color: #94a3b8; color: var(--grey); }
      .who { font-size: .8rem; color: var(--muted); }
      @media (max-width: 560px) {
        .card { grid-template-columns: 1fr; }
        .avatar { width: 42px; height: 42px; font-size: 1.15rem; border-radius: 12px; }
      }

      .empty { padding: 34px 20px; text-align: center; color: var(--muted); background: var(--bg2);
        border: 1px dashed var(--line); border-radius: var(--radius); }
      .empty .big { width: 64px; height: 64px; margin: 0 auto 8px; color: var(--blue); opacity: .85; }
      .empty .big svg { width: 100%; height: 100%; }
      .empty strong { display: block; color: var(--navy); font-size: 1.05rem; margin-bottom: 2px; }

      /* ---------- employers ---------- */
      .view[hidden] { display: none; }
      .view h2 { font-size: 1.25rem; margin: 4px 0 4px; }
      .sub { color: var(--muted); margin: 0 0 16px; font-size: .95rem; max-width: 46em; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 12px; }
      .co { background: var(--bg2); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px;
        display: grid; grid-template-columns: 44px 1fr; gap: 4px 12px; }
      .co .avatar { width: 44px; height: 44px; font-size: 1.2rem; border-radius: 12px; }
      .co a { font-weight: 700; color: var(--navy); text-decoration: none; }
      .co a:hover { color: var(--blue); text-decoration: underline; }
      .co p { margin: 2px 0 0; font-size: .88rem; color: var(--muted); }
      .co .actions { grid-column: 1 / -1; margin-top: 8px; }

      /* ---------- tip ---------- */
      .tip { display: flex; gap: 14px; align-items: flex-start; margin-top: 26px; padding: 16px 18px; border-radius: var(--radius);
        background: var(--blue-soft); border: 1px solid var(--line); }
      .tip .ico { font-size: 1.7rem; color: var(--blue); flex: none; margin-top: 2px; }
      .tip p { margin: 0; }
      .tip p:first-child { font-weight: 700; color: var(--navy); }
      .tip p + p { color: var(--muted); font-size: .92rem; }

      /* ---------- dialog ---------- */
      dialog { border: 1px solid var(--line); border-radius: 18px; background: var(--card); color: var(--text);
        padding: 22px; width: min(420px, calc(100vw - 32px)); box-shadow: 0 20px 60px rgba(0,0,0,.3); }
      dialog::backdrop { background: rgba(15,42,74,.5); }
      dialog h3 { margin: 0 0 6px; }
      dialog label { display: block; margin: 12px 0 4px; font-size: .9rem; color: var(--muted); }
      dialog input { width: 100%; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--line);
        background: var(--bg2); color: var(--text); font: inherit; }
      dialog .row { display: flex; gap: 8px; justify-content: flex-end; margin-top: 18px; }
      dialog button { font: inherit; padding: 9px 18px; border-radius: 10px; cursor: pointer;
        border: 1px solid var(--line); background: var(--bg2); color: var(--text); }
      dialog button.primary { background: var(--blue); border-color: var(--blue); color: #fff; font-weight: 600; }
      dialog .err { color: var(--red); font-size: .88rem; min-height: 1.2em; margin-top: 8px; }
    </style>
  </head>
  <body>
    <main class="wrap" id="app" data-api={config.api || ''}>
      <header class="hero">
        <div class="art" aria-hidden="true">
          <svg viewBox="0 0 440 190" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="mt1" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6aa5f5"/><stop offset="1" stop-color="#3b6fd8"/></linearGradient>
              <linearGradient id="mt2" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#a9c9fb"/><stop offset="1" stop-color="#7ea6ec"/></linearGradient>
              <linearGradient id="gr" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#34c28a"/><stop offset="1" stop-color="#0f8f63"/></linearGradient>
            </defs>
            <polygon points="120,190 250,40 330,120 380,70 440,190" fill="url(#mt2)"/>
            <polygon points="60,190 190,60 300,190" fill="url(#mt1)"/>
            <polygon points="190,60 168,90 190,84 205,96" fill="#fff" opacity=".85"/>
            <g fill="#2f5fb8" opacity=".9">
              <rect x="268" y="112" width="20" height="78"/><rect x="292" y="96" width="24" height="94"/><rect x="320" y="124" width="18" height="66"/>
              <rect x="342" y="104" width="22" height="86"/>
            </g>
            <g fill="#dbe8ff" opacity=".9">
              <rect x="274" y="122" width="4" height="6"/><rect x="274" y="136" width="4" height="6"/><rect x="298" y="108" width="4" height="6"/>
              <rect x="306" y="122" width="4" height="6"/><rect x="298" y="136" width="4" height="6"/><rect x="348" y="116" width="4" height="6"/>
              <rect x="356" y="132" width="4" height="6"/>
            </g>
            <g fill="url(#gr)">
              <polygon points="20,190 36,128 52,190"/><polygon points="38,190 58,112 78,190"/><polygon points="392,190 408,130 424,190"/>
              <polygon points="410,190 428,118 446,190"/>
            </g>
            <rect x="0" y="176" width="440" height="14" fill="#2b4a8a" opacity=".25"/>
            <path d="M92 176c0-14 10-22 26-24l22-14c6-4 14-6 22-6h34c10 0 18 4 24 10l10 10c12 2 20 8 20 24z" fill="#f4f8ff" stroke="#9db6e6" stroke-width="2"/>
            <path d="M150 138h38c6 0 11 3 14 8l-60 0z" fill="#b9d3fb"/>
            <circle cx="132" cy="178" r="12" fill="#1b2f55"/><circle cx="132" cy="178" r="5" fill="#cfd9ee"/>
            <circle cx="224" cy="178" r="12" fill="#1b2f55"/><circle cx="224" cy="178" r="5" fill="#cfd9ee"/>
            <path d="M386 26c-10 6-14 18-10 28 12-4 16-18 10-28z" fill="#34c28a"/>
            <path d="M235 22l-12 22h10l-6 20 18-26h-11l8-16z" fill="#f5b53b"/>
          </svg>
        </div>
        <div class="title">
          <svg class="cap" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <path d="M24 8 3 18l21 10 21-10L24 8Z" fill="currentColor"/>
            <path d="M11 24v9c0 3 6 7 13 7s13-4 13-7v-9l-13 6-13-6Z" fill="currentColor" opacity=".7"/>
            <path d="M43 19v13" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
          <h1>Co-op Finder: <em>Summer 2027</em></h1>
          <span class="live"><i></i>Live</span>
        </div>
        <p class="lead">Intern and co-op roles in mechanical, battery, EV and clean-energy engineering.</p>
        <p class="built"><span class="ico" id="ico-cal"></span>BC first, rest of Canada second. Last built {checked} (Pacific).</p>
      </header>

      <nav class="nav" id="nav" aria-label="Sections">
        <button type="button" data-view="jobs" aria-pressed="true"><span class="ico" data-i="briefcase"></span>Jobs <span class="cnt">{jobs.length}</span></button>
        <button type="button" data-view="bc" aria-pressed="false"><span class="ico" data-i="people"></span>Employers to check directly <span class="cnt">{bcList.length}</span></button>
        <button type="button" data-view="else" aria-pressed="false"><span class="ico" data-i="pin"></span>Elsewhere <span class="cnt">{elseList.length}</span></button>
      </nav>

      <div class="panel">
        <section class="view" data-view="jobs">
          <div class="filters">
            <div class="search">
              <span class="ico" data-i="search"></span>
              <input type="search" id="q" placeholder="Search title, company, location..." aria-label="Search jobs" />
            </div>
            <select id="region" aria-label="Region">
              <option value="all">All locations</option>
              <option value="bc">BC only</option>
              <option value="other">Outside BC</option>
            </select>
            <label class="chk"><input type="checkbox" id="sw" /> SolidWorks mentioned</label>
            <label class="chk"><input type="checkbox" id="mismatch" /> Show other start dates</label>
            <button type="button" class="linkbtn" id="clear"><span class="ico" data-i="refresh"></span>Clear filters</button>
          </div>

          <div class="pills" id="tabs" role="group" aria-label="Show postings">
            <button type="button" data-tab="review" aria-pressed="true"><span class="ico" data-i="refresh"></span>To review <span class="n"></span></button>
            <button type="button" data-tab="shortlist" aria-pressed="false"><span class="ico" data-i="star"></span>Shortlist <span class="n"></span></button>
            <button type="button" data-tab="applied" aria-pressed="false"><span class="ico" data-i="check"></span>Applied <span class="n"></span></button>
            <button type="button" data-tab="skip" aria-pressed="false"><span class="ico" data-i="x"></span>Skipped <span class="n"></span></button>
          </div>

          <div class="progress" id="progress"><span id="progress-text"></span><span class="bar"><i id="progress-bar"></i></span></div>
          <div class="status" id="status"></div>

          <div class="listhead">
            <span id="count"></span>
            <label>Sort by
              <select id="sort" aria-label="Sort by">
                <option value="best">Best match</option>
                <option value="new">Most recent</option>
                <option value="company">Company</option>
              </select>
            </label>
          </div>
          <div id="list"></div>
        </section>

        <section class="view" data-view="bc" hidden>
          <h2>Employers to check directly</h2>
          <p class="sub">These sites can't be pulled automatically, so each link goes straight to their careers page. Search for "intern" or "co-op". Use the buttons to keep track of the ones you've looked at. These are the BC ones.</p>
          <div class="grid">
            {bcList.map((c) => (
              <div class="co" data-id={`co:${c.name}`}>
                <div class="avatar" style={`background:linear-gradient(135deg,hsl(${hue(c.name)} 70% 52%),hsl(${(hue(c.name) + 40) % 360} 65% 38%))`}>{initial(c.name)}</div>
                <div>
                  <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>
                  {c.mode === 'auto' && <span class="tag good" style="margin-left:6px">auto</span>}
                  <p>{c.note}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="view" data-view="else" hidden>
          <h2>Elsewhere</h2>
          <p class="sub">Employers outside BC. Same idea: open the careers page and search for "intern" or "co-op".</p>
          <div class="grid">
            {elseList.map((c) => (
              <div class="co" data-id={`co:${c.name}`}>
                <div class="avatar" style={`background:linear-gradient(135deg,hsl(${hue(c.name)} 70% 52%),hsl(${(hue(c.name) + 40) % 360} 65% 38%))`}>{initial(c.name)}</div>
                <div>
                  <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>
                  <p>{c.note}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      </div>

      <div class="tip">
        <span class="ico" data-i="bulb"></span>
        <div>
          <p>Tip: Don't forget UBC's own co-op job portal, which needs a login and can't be listed here.</p>
          <p>Always confirm start dates and details on the employer's posting.</p>
        </div>
      </div>
    </main>

    <dialog id="setup">
      <form method="dialog" id="setup-form">
        <h3>Who's marking?</h3>
        <p class="who" style="margin:0">Your name shows next to your marks so everyone knows who picked what.</p>
        <label for="s-name">Your name or nickname</label>
        <input id="s-name" maxlength="30" autocomplete="off" required />
        <label for="s-pass" id="s-pass-label">Passcode</label>
        <input id="s-pass" type="password" autocomplete="off" />
        <div class="err" id="s-err"></div>
        <div class="row">
          <button type="button" id="s-cancel">Cancel</button>
          <button type="submit" class="primary">Save</button>
        </div>
      </form>
    </dialog>

    <script id="jobs-data" type="application/json" set:html={JSON.stringify(jobs)}></script>
    <script is:inline>
      (function () {
        var jobs = JSON.parse(document.getElementById('jobs-data').textContent);
        var API = (document.getElementById('app').getAttribute('data-api') || '').replace(/\/$/, '');
        var $ = function (id) { return document.getElementById(id); };
        var list = $('list'), count = $('count');

        // ---- static icons (fixed strings, no user content) ----
        var P = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
        var ICONS = {
          briefcase: '<svg ' + P + '><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18"/></svg>',
          people: '<svg ' + P + '><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.6-3.6 3.2-5.5 6.5-5.5s5.9 1.9 6.5 5.5"/><circle cx="17.5" cy="9" r="2.5"/><path d="M17 14.5c2.6.1 4.3 1.6 4.8 4.5"/></svg>',
          pin: '<svg ' + P + '><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>',
          search: '<svg ' + P + '><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>',
          refresh: '<svg ' + P + '><path d="M20 11a8 8 0 0 0-14.3-4.3L4 8.5M4 4v4.5h4.5M4 13a8 8 0 0 0 14.3 4.3L20 15.5M20 20v-4.5h-4.5"/></svg>',
          star: '<svg ' + P + '><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3Z"/></svg>',
          check: '<svg ' + P + '><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>',
          x: '<svg ' + P + '><path d="M6 6l12 12M18 6 6 18"/></svg>',
          cal: '<svg ' + P + '><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>',
          bulb: '<svg ' + P + '><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3Z"/></svg>',
          empty: '<svg ' + P + '><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M9 14h6"/></svg>',
        };
        function icon(name) { var s = document.createElement('span'); s.className = 'ico'; s.innerHTML = ICONS[name] || ''; return s; }
        (function paintStatic() {
          var n = document.querySelectorAll('[data-i]');
          for (var i = 0; i < n.length; i++) n[i].innerHTML = ICONS[n[i].getAttribute('data-i')] || '';
          $('ico-cal').innerHTML = ICONS.cal;
        })();

        // ---- tiny safe wrappers around localStorage (it can be blocked) ----
        function lsGet(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
        function lsSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
        function lsDel(k) { try { localStorage.removeItem(k); } catch (e) {} }

        var marks = {};
        try { marks = JSON.parse(lsGet('cf_marks') || '{}') || {}; } catch (e) { marks = {}; }
        var who = lsGet('cf_name') || '';
        var pass = lsGet('cf_pass') || '';
        var tab = 'review';
        var link = API ? 'connecting' : 'local'; // connecting | online | offline | local

        // ---- sorting ----
        function rank(j) { return j.fitsMay === true ? 0 : j.fitsMay === null ? 1 : 2; }
        var SORTS = {
          best: function (a, b) {
            return rank(a) - rank(b) || (b.bc - a.bc) || (b.score - a.score) || String(b.posted).localeCompare(String(a.posted));
          },
          new: function (a, b) { return String(b.posted).localeCompare(String(a.posted)) || SORTS.best(a, b); },
          company: function (a, b) { return String(a.company).localeCompare(String(b.company)) || SORTS.best(a, b); },
        };

        function el(tag, cls, text) {
          var e = document.createElement(tag);
          if (cls) e.className = cls;
          if (text != null) e.textContent = text;
          return e;
        }
        function tag(text, kind, ico) {
          var t = el('span', 'tag' + (kind ? ' ' + kind : ''));
          if (ico) t.appendChild(icon(ico));
          t.appendChild(document.createTextNode(text));
          return t;
        }
        function stateOf(id) { return marks[id] ? marks[id].state : null; }
        function hue(name) { var h = 7; for (var i = 0; i < name.length; i++) h = (h * 31 + name.charCodeAt(i)) % 360; return h; }
        function avatar(name) {
          var a = el('div', 'avatar', (String(name).match(/[A-Za-z]/) || ['?'])[0].toUpperCase());
          var h = hue(String(name));
          a.style.background = 'linear-gradient(135deg,hsl(' + h + ' 70% 52%),hsl(' + ((h + 40) % 360) + ' 65% 38%))';
          return a;
        }

        // ---- marks: save locally, then to the shared store ----
        function saveLocal() { lsSet('cf_marks', JSON.stringify(marks)); }

        function syncDown() {
          if (!API) return;
          fetch(API + '/marks', { cache: 'no-store' })
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(function (d) { marks = d.marks || {}; saveLocal(); link = 'online'; renderAll(); })
            .catch(function () { link = 'offline'; renderStatus(); });
        }

        function setMark(id, state) {
          if (API && (!who || !pass)) { openSetup(function () { setMark(id, state); }); return; }
          if (!API && !who) who = 'me';
          var next = stateOf(id) === state ? null : state;
          if (next) marks[id] = { state: next, by: who, ts: Date.now() };
          else delete marks[id];
          saveLocal();
          renderAll();
          if (!API) return;
          fetch(API + '/marks', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Passcode': pass },
            body: JSON.stringify({ id: id, state: next, by: who }),
          }).then(function (r) {
            if (r.status === 401) {
              pass = ''; lsDel('cf_pass');
              flash('That passcode was not accepted. Tap a button again to re-enter it.');
              syncDown();
              return;
            }
            if (!r.ok) throw new Error('HTTP ' + r.status);
            link = 'online'; renderStatus();
          }).catch(function () {
            link = 'offline';
            flash('Could not reach the shared list. Your mark is saved on this device only for now.');
          });
        }

        var flashTimer, flashMsg = '';
        function flash(msg) {
          flashMsg = msg;
          renderStatus();
          clearTimeout(flashTimer);
          flashTimer = setTimeout(function () { flashMsg = ''; renderStatus(); }, 8000);
        }

        // ---- who-are-you dialog ----
        var afterSetup = null;
        function openSetup(cb) {
          afterSetup = cb || null;
          $('s-name').value = who;
          $('s-pass').value = '';
          $('s-pass').style.display = API ? '' : 'none';
          $('s-pass-label').style.display = API ? '' : 'none';
          $('s-err').textContent = '';
          var d = $('setup');
          if (d.showModal) d.showModal(); else d.setAttribute('open', '');
        }
        function closeSetup() { var d = $('setup'); if (d.close) d.close(); else d.removeAttribute('open'); }
        $('s-cancel').addEventListener('click', function () { afterSetup = null; closeSetup(); });
        $('setup-form').addEventListener('submit', function (e) {
          e.preventDefault();
          var n = $('s-name').value.trim(), p = $('s-pass').value.trim();
          if (!n) { $('s-err').textContent = 'Please enter a name.'; return; }
          if (API && !p && !pass) { $('s-err').textContent = 'Please enter the passcode.'; return; }
          who = n; lsSet('cf_name', who);
          if (API && p) { pass = p; lsSet('cf_pass', pass); }
          closeSetup();
          renderAll();
          var cb = afterSetup; afterSetup = null;
          if (cb) cb();
        });

        // ---- rendering ----
        function when(ts) {
          try { return new Date(ts).toLocaleDateString('en-CA', { month: 'short', day: 'numeric' }); } catch (e) { return ''; }
        }
        var LABEL = { shortlist: 'Shortlisted', applied: 'Applied', skip: 'Skipped' };

        function actionsRow(id, isEmployer) {
          var row = el('div', 'actions');
          var defs = isEmployer
            ? [['shortlist', 'Shortlist', 'star'], ['applied', 'Checked', 'check']]
            : [['shortlist', 'Shortlist', 'star'], ['applied', 'Applied', 'check'], ['skip', 'Skip', 'x']];
          var cur = stateOf(id);
          defs.forEach(function (d) {
            var b = el('button', cur === d[0] ? 'on-' + d[0] : '');
            b.type = 'button';
            b.appendChild(icon(d[2]));
            b.appendChild(document.createTextNode(d[1]));
            b.setAttribute('aria-pressed', cur === d[0] ? 'true' : 'false');
            b.addEventListener('click', function () { setMark(id, d[0]); });
            row.appendChild(b);
          });
          if (marks[id]) {
            var lab = isEmployer && cur === 'applied' ? 'Checked' : LABEL[cur];
            row.appendChild(el('span', 'who', lab + ' by ' + marks[id].by + (marks[id].ts ? ' · ' + when(marks[id].ts) : '')));
          }
          return row;
        }

        function card(j) {
          var c = el('div', 'card');
          c.setAttribute('data-state', stateOf(j.id) || 'review');
          c.appendChild(avatar(j.company));
          var body = el('div');
          var h = el('h3');
          var a = el('a', null, j.title);
          a.href = j.url; a.target = '_blank'; a.rel = 'noopener noreferrer';
          h.appendChild(a); body.appendChild(h);
          var meta = el('div', 'meta');
          meta.appendChild(el('span', null, j.company));
          if (j.location) {
            var loc = el('span'); loc.appendChild(icon('pin')); loc.appendChild(document.createTextNode(j.location));
            meta.appendChild(loc);
          }
          body.appendChild(meta);
          var t = el('div', 'tags');
          if (j.fitsMay === true) t.appendChild(tag('Starts ' + j.startLabel, 'good', 'check'));
          else if (j.fitsMay === false) t.appendChild(tag('Starts ' + j.startLabel + ' (not May 2027)', 'warn', 'cal'));
          else t.appendChild(tag('Start date not listed', 'warn', 'cal'));
          t.appendChild(j.bc ? tag('BC', 'good') : tag('Outside BC'));
          if (j.solidworks) t.appendChild(tag('SolidWorks', 'good'));
          if (j.source === 'manual') t.appendChild(tag('Hand-picked', 'info'));
          if (j.posted) t.appendChild(tag('Posted ' + j.posted, 'info', 'cal'));
          body.appendChild(t);
          if (j.source === 'manual' && j.note) {
            var n = el('p', 'note', j.note);
            body.appendChild(n);
            if (j.note.length > 140) {
              var m = el('button', 'more', 'Show more');
              m.type = 'button';
              m.addEventListener('click', function () {
                var open = n.classList.toggle('open');
                m.textContent = open ? 'Show less' : 'Show more';
              });
              body.appendChild(m);
            }
          }
          body.appendChild(actionsRow(j.id, false));
          c.appendChild(body);
          return c;
        }

        function renderTabs() {
          var counts = { review: 0, shortlist: 0, applied: 0, skip: 0 };
          jobs.forEach(function (j) { var s = stateOf(j.id); counts[s || 'review']++; });
          var btns = $('tabs').querySelectorAll('button');
          for (var i = 0; i < btns.length; i++) {
            var t = btns[i].getAttribute('data-tab');
            btns[i].setAttribute('aria-pressed', t === tab ? 'true' : 'false');
            btns[i].querySelector('.n').textContent = '(' + counts[t] + ')';
          }
          var done = jobs.length - counts.review;
          $('progress-text').textContent = done + ' of ' + jobs.length + ' jobs reviewed';
          $('progress-bar').style.width = (jobs.length ? Math.round(100 * done / jobs.length) : 0) + '%';
        }

        function renderStatus() {
          var s = $('status');
          s.textContent = '';
          var dot = el('span', 'dot' + (link === 'online' ? ' online' : link === 'offline' ? ' offline' : ''));
          var first = el('span');
          first.appendChild(dot);
          first.appendChild(document.createTextNode(
            link === 'online' ? 'Shared list connected.'
            : link === 'connecting' ? 'Connecting to the shared list…'
            : link === 'offline' ? 'Shared list unreachable right now. Marks are kept on this device.'
            : 'Marks are saved on this device only (shared list not set up yet).'));
          s.appendChild(first);
          if (who) s.appendChild(el('span', null, 'Marking as ' + who + '.'));
          var b = el('button', 'linkbtn', who ? 'Change name or passcode' : 'Set your name');
          b.type = 'button';
          b.addEventListener('click', function () { openSetup(null); });
          s.appendChild(b);
          if (flashMsg) s.appendChild(el('span', 'err', flashMsg));
        }

        function emptyState() {
          var box = el('div', 'empty');
          var big = el('div', 'big'); big.innerHTML = ICONS.empty; box.appendChild(big);
          box.appendChild(el('strong', null, tab === 'review' ? 'Nothing left to review' : 'Nothing here yet'));
          box.appendChild(el('span', null, tab === 'review'
            ? 'Try "Show other start dates", clear the filters, or check the Employers tabs.'
            : 'Jobs you mark will show up here for everyone.'));
          return box;
        }

        function renderJobs() {
          var q = $('q').value.trim().toLowerCase();
          var region = $('region').value, sw = $('sw').checked, mm = $('mismatch').checked;
          var shown = jobs.filter(function (j) {
            var s = stateOf(j.id) || 'review';
            if (s !== tab) return false;
            if (!mm && j.fitsMay === false) return false;
            if (sw && !j.solidworks) return false;
            if (region === 'bc' && !j.bc) return false;
            if (region === 'other' && j.bc) return false;
            if (q && (j.title + ' ' + j.company + ' ' + j.location).toLowerCase().indexOf(q) === -1) return false;
            return true;
          }).sort(SORTS[$('sort').value] || SORTS.best);
          list.textContent = '';
          shown.forEach(function (j) { list.appendChild(card(j)); });
          if (!shown.length) list.appendChild(emptyState());
          var inTab = jobs.filter(function (j) { return (stateOf(j.id) || 'review') === tab; }).length;
          var hidden = inTab - shown.length;
          count.textContent = shown.length + ' shown' + (hidden ? ' · ' + hidden + ' hidden by filters' : '');
        }

        function renderEmployers() {
          var cos = document.querySelectorAll('.co[data-id]');
          for (var i = 0; i < cos.length; i++) {
            var node = cos[i];
            var old = node.querySelector('.actions');
            if (old) node.removeChild(old);
            node.appendChild(actionsRow(node.getAttribute('data-id'), true));
          }
        }

        function renderAll() { renderTabs(); renderStatus(); renderJobs(); renderEmployers(); }

        $('tabs').addEventListener('click', function (e) {
          var b = e.target.closest('button[data-tab]');
          if (!b) return;
          tab = b.getAttribute('data-tab');
          renderAll();
        });
        ['q', 'region', 'sw', 'mismatch', 'sort'].forEach(function (id) {
          $(id).addEventListener(id === 'q' ? 'input' : 'change', renderJobs);
        });
        $('clear').addEventListener('click', function () {
          $('q').value = ''; $('region').value = 'all'; $('sw').checked = false; $('mismatch').checked = false; $('sort').value = 'best';
          renderJobs();
        });

        // ---- top-level tabs ----
        function showView(v) {
          if (v !== 'jobs' && v !== 'bc' && v !== 'else') v = 'jobs';
          var secs = document.querySelectorAll('.view');
          for (var i = 0; i < secs.length; i++) secs[i].hidden = secs[i].getAttribute('data-view') !== v;
          var nb = $('nav').querySelectorAll('button');
          for (var k = 0; k < nb.length; k++) nb[k].setAttribute('aria-pressed', nb[k].getAttribute('data-view') === v ? 'true' : 'false');
        }
        $('nav').addEventListener('click', function (e) {
          var b = e.target.closest('button[data-view]');
          if (!b) return;
          var v = b.getAttribute('data-view');
          showView(v);
          try { history.replaceState(null, '', '#' + v); } catch (err) {}
        });
        showView((location.hash || '').slice(1));

        renderAll();
        syncDown();
        document.addEventListener('visibilitychange', function () { if (!document.hidden) syncDown(); });
        if (API) setInterval(syncDown, 60000);
      })();
    </script>
  </body>
</html>
