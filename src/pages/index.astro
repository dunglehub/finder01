        // ---- add / remove postings ----
        function removePost(j) {
          if (!confirm('Remove "' + j.title + '" for everyone?')) return;
          if (!pass) { openSetup(function () { removePost(j); }); return; }
          fetch(API + '/posts?id=' + encodeURIComponent(j.id), { method: 'DELETE', headers: { 'X-Passcode': pass } })
            .then(function (r) {
              if (r.status === 401) { logout('Your passcode was not accepted. Please log in again.'); return; }
              if (!r.ok) throw new Error('HTTP ' + r.status);
              posts = posts.filter(function (x) { return x.id !== j.id; });
