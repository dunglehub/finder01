            .then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok, status: r.status, d: d }; }); })
            .then(function (res) {
              if (res.status === 401) { logout('Your passcode was not accepted. Please log in again.'); return { ok: false, error: 'Please log in again.' }; }
              if (!res.ok || !res.d.employers) { var m = (res.d && res.d.error) || failMsg; flash(m); return { ok: false, error: m }; }
              setEmployers(res.d.employers); rebuildJobs(); renderAll(); return { ok: true };
            })
            .catch(function () { flash(failMsg); return { ok: false, error: failMsg }; });
