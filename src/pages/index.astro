        });
        $('e-cancel').addEventListener('click', closeEmp);
        $('emp-form').addEventListener('submit', function (e) {
          e.preventDefault();
          var name = $('e-name').value.trim(), url = $('e-url').value.trim(), region = $('e-region').value;
          if (!name) { $('e-err').textContent = 'Please add the company name.'; return; }
          if (!/^https?:\/\/\S+$/i.test(url)) { $('e-err').textContent = 'The link must start with http:// or https://'; return; }
          var dup = Array.prototype.some.call(document.querySelectorAll('.co[data-id]'), function (n) { return normName(n.getAttribute('data-id').slice(3)) === normName(name); });
          if (dup) { $('e-err').textContent = isHiddenCo(name) ? 'That company is in the list but hidden. Use Show again under Hidden.' : 'That company is already in the list.'; return; }
          var btn = $('e-save'); btn.disabled = true;
          empAct({ action: 'add', employer: { name: name, url: url, region: region, note: $('e-note').value.trim() } }, 'Could not add it. Please try again.')
            .then(function (r) {
