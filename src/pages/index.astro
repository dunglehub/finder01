        function renderJobs() {
          var q = $('q').value.trim().toLowerCase();
          var on = CRITERIA.map(function (c) { return $(c.id).checked; });
          var prevIndex = -1;
          for (var p = 0; p < curShown.length; p++) if (curShown[p].id === selId) { prevIndex = p; break; }
          var shown = jobs.filter(function (j) {
            var s = stateOf(j.id) || 'review';
            if (s !== tab) return false;
            var f = flags(j);
            for (var k = 0; k < on.length; k++) if (on[k] && !f[k]) return false;
            if (q && (j.title + ' ' + j.company + ' ' + j.location).toLowerCase().indexOf(q) === -1) return false;
            return true;
          }).sort(SORTS[$('sort').value] || SORTS.priority);
          curShown = shown;
          // Keep the selection; if it left the list (for example after Shortlist), move to the next one.
          var still = shown.some(function (j) { return j.id === selId; });
          if (!still) {
            if (isNarrow()) { selId = null; $('app').classList.remove('show-detail'); }
            else selId = shown.length ? shown[Math.max(0, Math.min(prevIndex < 0 ? 0 : prevIndex, shown.length - 1))].id : null;
