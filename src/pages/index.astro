            $('cnt-' + vw).textContent = shownCount;
          });
          var adds = document.querySelectorAll('[data-emp-add]');
          for (i = 0; i < adds.length; i++) adds[i].classList.toggle('show', logged);
        }

        function openEmp(region) {
          if (!pass) { openSetup(function () { openEmp(region); }); return; }
          ['e-name', 'e-url', 'e-note'].forEach(function (id) { $(id).value = ''; });
          $('e-region').value = region === 'BC' ? 'BC' : 'Elsewhere'; $('e-err').textContent = ''; $('e-save').disabled = false;
          var d = $('emp-dialog'); if (d.showModal) d.showModal(); else d.setAttribute('open', '');
