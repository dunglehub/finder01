        function cleanText(t) {
          t = String(t || '');
          for (var k = 0; k < 3; k++) {
            t = t.replace(/&amp;/gi, '&').replace(/&nbsp;|&#160;|&#xa0;/gi, ' ').replace(/&lt;/gi, '<').replace(/&gt;/gi, '>')
              .replace(/&quot;|&#34;/gi, '"').replace(/&#0?39;|&rsquo;|&apos;/gi, "'").replace(/&ndash;|&#8211;/gi, '-');
