---
import autoJobs from '../../data/jobs.json';
import manualJobs from '../../data/manual-jobs.json';
import watchlist from '../../data/watchlist.json';
import config from '../../data/config.json';
import { enrich } from '../../scripts/lib/classify.mjs';

// Manual jobs are enriched the same way as automatic ones, then tagged "hand-picked".
const manual = manualJobs.map((j) =>
  enrich({ ...j, source: 'manual', description: `${j.start ? 'Starting ' + j.start + '. ' : ''}${j.note || ''}` }),
);
const jobs = [...manual, ...autoJobs];

const checked = new Date().toLocaleString('en-CA', {
  dateStyle: 'medium', timeStyle: 'short', timeZone: 'America/Vancouver',
});

const bcList = watchlist.filter((c) => c.region === 'BC');
const elseList = watchlist.filter((c) => c.region !== 'BC');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Co-op Finder: Summer 2027</title>
    <meta name="description" content="Intern and co-op postings in battery, EV and clean-energy engineering, starting May 2027." />
    <style is:global>
      :root {
        --bg: #f7f8fa; --card: #ffffff; --text: #1b2430; --muted: #5d6b7c; --line: #e2e6ec;
        --accent: #0b6e4f; --accent-bg: #e3f4ec; --warn: #8a5a00; --warn-bg: #fff2d6; --grey-bg: #eceff3;
        --star: #b7791f; --star-bg: #fff4d6; --bad: #a33a3a; --bad-bg: #fbe6e6;
      }
      @media (prefers-color-scheme: dark) {
        :root { --bg: #11161c; --card: #19212a; --text: #e8edf3; --muted: #9aa8b8; --line: #2a3541;
          --accent: #5fd6a4; --accent-bg: #16382c; --warn: #f2c261; --warn-bg: #3a2f14; --grey-bg: #25303b;
          --star: #f2c261; --star-bg: #3a2f14; --bad: #f09a9a; --bad-bg: #3d2020; }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--text);
        font: 16px/1.5 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
      .wrap { max-width: 920px; margin: 0 auto; padding: 24px 16px 64px; }
      h1 { font-size: 1.6rem; margin: 0 0 4px; }
      h2 { font-size: 1.15rem; margin: 36px 0 12px; }
      .sub { color: var(--muted); margin: 0 0 20px; }
      .bar { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center;
        background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; }
      .bar input[type=search], .bar select { padding: 8px 10px; border-radius: 8px; border: 1px solid var(--line);
        background: var(--bg); color: var(--text); font: inherit; }
      .bar input[type=search] { flex: 1 1 200px; min-width: 0; }
      .bar label { display: flex; gap: 6px; align-items: center; font-size: .92rem; color: var(--muted); }
      .nav { display: flex; flex-wrap: wrap; gap: 4px; margin: 18px 0 0; border-bottom: 1px solid var(--line); }
      .nav button { font: inherit; padding: 9px 16px; cursor: pointer; background: none; border: none;
        border-bottom: 3px solid transparent; color: var(--muted); margin-bottom: -1px; }
      .nav button[aria-pressed=true] { color: var(--text); border-bottom-color: var(--accent); font-weight: 600; }
      .view[hidden] { display: none; }
      .view > h2:first-child { margin-top: 20px; }
      .tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 0; }
      .tabs button { font: inherit; font-size: .92rem; padding: 7px 14px; border-radius: 999px; cursor: pointer;
        border: 1px solid var(--line); background: var(--card); color: var(--text); }
      .tabs button[aria-pressed=true] { background: var(--accent); border-color: var(--accent); color: #fff; }
      .tabs .n { opacity: .75; margin-left: 4px; }
      .status { color: var(--muted); font-size: .85rem; margin: 10px 2px 0; display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; }
      .status button { font: inherit; font-size: .85rem; background: none; border: none; color: var(--accent);
        cursor: pointer; padding: 0; text-decoration: underline; }
      .count { color: var(--muted); font-size: .9rem; margin: 12px 2px; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; margin-bottom: 10px; }
      .card h3 { margin: 0 0 2px; font-size: 1.05rem; }
      .card h3 a { color: inherit; text-decoration: none; }
      .card h3 a:hover { text-decoration: underline; }
      .meta { color: var(--muted); font-size: .92rem; }
      .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
      .tag { font-size: .78rem; padding: 2px 9px; border-radius: 999px; background: var(--grey-bg); color: var(--muted); }
      .tag.good { background: var(--accent-bg); color: var(--accent); }
      .tag.warn { background: var(--warn-bg); color: var(--warn); }
      .note { margin: 8px 0 0; font-size: .92rem; }
      .actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 10px; }
      .actions button { font: inherit; font-size: .88rem; padding: 6px 12px; border-radius: 8px; cursor: pointer;
        border: 1px solid var(--line); background: var(--bg); color: var(--text); }
      .actions button:hover { border-color: var(--muted); }
      .actions button.on-shortlist { background: var(--star-bg); border-color: var(--star); color: var(--star); font-weight: 600; }
      .actions button.on-applied { background: var(--accent-bg); border-color: var(--accent); color: var(--accent); font-weight: 600; }
      .actions button.on-skip { background: var(--bad-bg); border-color: var(--bad); color: var(--bad); font-weight: 600; }
      .who { font-size: .8rem; color: var(--muted); }
      .empty { padding: 24px; text-align: center; color: var(--muted); background: var(--card);
        border: 1px dashed var(--line); border-radius: 12px; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 10px; }
      .co { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; }
      .co a { font-weight: 600; color: inherit; }
      .co p { margin: 4px 0 0; font-size: .88rem; color: var(--muted); }
      .foot { margin-top: 40px; color: var(--muted); font-size: .85rem; }
      dialog { border: 1px solid var(--line); border-radius: 14px; background: var(--card); color: var(--text);
        padding: 20px; width: min(420px, calc(100vw - 32px)); }
      dialog::backdrop { background: rgba(0,0,0,.45); }
      dialog h3 { margin: 0 0 6px; }
      dialog label { display: block; margin: 12px 0 4px; font-size: .9rem; color: var(--muted); }
      dialog input { width: 100%; padding: 9px 10px; border-radius: 8px; border: 1px solid var(--line);
        background: var(--bg); color: var(--text); font: inherit; }
      dialog .row { display: flex; gap: 8px; justify-content: flex-end; margin-top: 16px; }
      dialog button { font: inherit; padding: 8px 16px; border-radius: 8px; cursor: pointer;
        border: 1px solid var(--line); background: var(--bg); color: var(--text); }
      dialog button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
      .err { color: var(--bad); font-size: .88rem; min-height: 1.2em; margin-top: 8px; }
    </style>
  </head>
  <body>
    <main class="wrap" id="app" data-api={config.api || ''}>
      <h1>Co-op Finder: Summer 2027</h1>
      <p class="sub">
        Intern and co-op roles in mechanical, battery, EV and clean-energy engineering. BC first, rest of Canada second.
        Last built {checked} (Pacific).
      </p>

      <nav class="nav" id="nav" aria-label="Sections">
        <button type="button" data-view="jobs" aria-pressed="true">Jobs</button>
        <button type="button" data-view="bc" aria-pressed="false">Employers to check directly</button>
        <button type="button" data-view="else" aria-pressed="false">Elsewhere</button>
      </nav>
      <div class="status" id="status"></div>

      <section class="view" data-view="jobs">
      <div class="bar">
        <input type="search" id="q" placeholder="Search title, company, location" aria-label="Search jobs" />
        <select id="region" aria-label="Region">
          <option value="all">All locations</option>
          <option value="bc">BC only</option>
          <option value="other">Outside BC</option>
        </select>
        <label><input type="checkbox" id="sw" /> SolidWorks mentioned</label>
        <label><input type="checkbox" id="mismatch" /> Show other start dates</label>
      </div>

      <div class="tabs" id="tabs" role="group" aria-label="Show postings">
        <button type="button" data-tab="review" aria-pressed="true">To review<span class="n"></span></button>
        <button type="button" data-tab="shortlist" aria-pressed="false">&#9733; Shortlist<span class="n"></span></button>
        <button type="button" data-tab="applied" aria-pressed="false">&#10003; Applied<span class="n"></span></button>
        <button type="button" data-tab="skip" aria-pressed="false">&#10005; Skipped<span class="n"></span></button>
      </div>

      <div class="count" id="count"></div>
      <div id="list"></div>
      </section>

      <section class="view" data-view="bc" hidden>
      <h2>Employers to check directly</h2>
      <p class="sub">These sites can't be pulled automatically, so each link goes straight to their careers page. Search for "intern" or "co-op". Use the buttons to keep track of the ones you've looked at. These are the BC ones.</p>
      <div class="grid">
        {bcList.map((c) => (
          <div class="co" data-id={`co:${c.name}`}>
            <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>
            {c.mode === 'auto' && <span class="tag good" style="margin-left:6px">auto</span>}
            <p>{c.note}</p>
          </div>
        ))}
      </div>

      </section>

      <section class="view" data-view="else" hidden>
      <h2>Elsewhere</h2>
      <p class="sub">Employers outside BC. Same idea: open the careers page and search for "intern" or "co-op".</p>
      <div class="grid">
        {elseList.map((c) => (
          <div class="co" data-id={`co:${c.name}`}>
            <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>
            <p>{c.note}</p>
          </div>
        ))}
      </div>
      </section>

      <p class="foot">
        Don't forget UBC's own co-op job portal, which needs a login and can't be listed here.
        Always confirm start dates and details on the employer's posting.
      </p>
    </main>

    <dialog id="setup">
      <form method="dialog" id="setup-form">
        <h3>Who's marking?</h3>
        <p class="who" style="margin:0">Your name shows next to your marks so everyone knows who picked what.</p>
        <label for="s-name">Your name or nickname</label>
        <input id="s-name" maxlength="30" autocomplete="off" required />
        <label for="s-pass" id="s-pass-label">Passcode</label>
        <input id="s-pass" type="password" autocomplete="off" />
        <div class="err" id="s-err"></div>
        <div class="row">
          <button type="button" id="s-cancel">Cancel</button>
          <button type="submit" class="primary">Save</button>
        </div>
      </form>
    </dialog>

    <script id="jobs-data" type="application/json" set:html={JSON.stringify(jobs)}></script>
    <script is:inline>
      (function () {
        var jobs = JSON.parse(document.getElementById('jobs-data').textContent);
        var API = (document.getElementById('app').getAttribute('data-api') || '').replace(/\/$/, '');
        var $ = function (id) { return document.getElementById(id); };
        var list = $('list'), count = $('count');

        // ---- tiny safe wrappers around localStorage (it can be blocked) ----
        function lsGet(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
        function lsSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
        function lsDel(k) { try { localStorage.removeItem(k); } catch (e) {} }

        var marks = {};
        try { marks = JSON.parse(lsGet('cf_marks') || '{}') || {}; } catch (e) { marks = {}; }
        var who = lsGet('cf_name') || '';
        var pass = lsGet('cf_pass') || '';
        var tab = 'review';
        var link = API ? 'connecting' : 'local'; // connecting | online | offline | local

        // ---- ranking: best matches first ----
        function rank(j) { return j.fitsMay === true ? 0 : j.fitsMay === null ? 1 : 2; }
        jobs.sort(function (a, b) {
          return rank(a) - rank(b) || (b.bc - a.bc) || (b.score - a.score) || String(b.posted).localeCompare(String(a.posted));
        });

        function el(tag, cls, text) {
          var e = document.createElement(tag);
          if (cls) e.className = cls;
          if (text != null) e.textContent = text;
          return e;
        }
        function tag(text, kind) { return el('span', 'tag' + (kind ? ' ' + kind : ''), text); }
        function stateOf(id) { return marks[id] ? marks[id].state : null; }

        // ---- marks: save locally, then to the shared store ----
        function saveLocal() { lsSet('cf_marks', JSON.stringify(marks)); }

        function syncDown() {
          if (!API) return;
          fetch(API + '/marks', { cache: 'no-store' })
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(function (d) { marks = d.marks || {}; saveLocal(); link = 'online'; renderAll(); })
            .catch(function () { link = 'offline'; renderStatus(); });
        }

        function setMark(id, state) {
          if (API && (!who || !pass)) { openSetup(function () { setMark(id, state); }); return; }
          if (!API && !who) who = 'me';
          var next = stateOf(id) === state ? null : state;
          if (next) marks[id] = { state: next, by: who, ts: Date.now() };
          else delete marks[id];
          saveLocal();
          renderAll();
          if (!API) return;
          fetch(API + '/marks', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Passcode': pass },
            body: JSON.stringify({ id: id, state: next, by: who }),
          }).then(function (r) {
            if (r.status === 401) {
              pass = ''; lsDel('cf_pass');
              flash('That passcode was not accepted. Tap a button again to re-enter it.');
              syncDown();
              return;
            }
            if (!r.ok) throw new Error('HTTP ' + r.status);
            link = 'online'; renderStatus();
          }).catch(function () {
            link = 'offline';
            flash('Could not reach the shared list. Your mark is saved on this device only for now.');
          });
        }

        var flashTimer, flashMsg = '';
        function flash(msg) {
          flashMsg = msg;
          renderStatus();
          clearTimeout(flashTimer);
          flashTimer = setTimeout(function () { flashMsg = ''; renderStatus(); }, 8000);
        }

        // ---- who-are-you dialog ----
        var afterSetup = null;
        function openSetup(cb) {
          afterSetup = cb || null;
          $('s-name').value = who;
          $('s-pass').value = '';
          $('s-pass').style.display = API ? '' : 'none';
          $('s-pass-label').style.display = API ? '' : 'none';
          $('s-err').textContent = '';
          var d = $('setup');
          if (d.showModal) d.showModal(); else d.setAttribute('open', '');
        }
        function closeSetup() { var d = $('setup'); if (d.close) d.close(); else d.removeAttribute('open'); }
        $('s-cancel').addEventListener('click', function () { afterSetup = null; closeSetup(); });
        $('setup-form').addEventListener('submit', function (e) {
          e.preventDefault();
          var n = $('s-name').value.trim(), p = $('s-pass').value.trim();
          if (!n) { $('s-err').textContent = 'Please enter a name.'; return; }
          if (API && !p && !pass) { $('s-err').textContent = 'Please enter the passcode.'; return; }
          who = n; lsSet('cf_name', who);
          if (API && p) { pass = p; lsSet('cf_pass', pass); }
          closeSetup();
          renderAll();
          var cb = afterSetup; afterSetup = null;
          if (cb) cb();
        });

        // ---- rendering ----
        function when(ts) {
          try { return new Date(ts).toLocaleDateString('en-CA', { month: 'short', day: 'numeric' }); } catch (e) { return ''; }
        }
        var LABEL = { shortlist: 'Shortlisted', applied: 'Applied', skip: 'Skipped' };

        function actionsRow(id, isEmployer) {
          var row = el('div', 'actions');
          var defs = isEmployer
            ? [['shortlist', '★ Shortlist'], ['applied', '✓ Checked']]
            : [['shortlist', '★ Shortlist'], ['applied', '✓ Applied'], ['skip', '✕ Skip']];
          var cur = stateOf(id);
          defs.forEach(function (d) {
            var b = el('button', cur === d[0] ? 'on-' + d[0] : '', d[1]);
            b.type = 'button';
            b.setAttribute('aria-pressed', cur === d[0] ? 'true' : 'false');
            b.addEventListener('click', function () { setMark(id, d[0]); });
            row.appendChild(b);
          });
          if (marks[id]) {
            var lab = isEmployer && cur === 'applied' ? 'Checked' : LABEL[cur];
            row.appendChild(el('span', 'who', lab + ' by ' + marks[id].by + (marks[id].ts ? ' · ' + when(marks[id].ts) : '')));
          }
          return row;
        }

        function card(j) {
          var c = el('div', 'card');
          var h = el('h3');
          var a = el('a', null, j.title);
          a.href = j.url; a.target = '_blank'; a.rel = 'noopener noreferrer';
          h.appendChild(a); c.appendChild(h);
          c.appendChild(el('div', 'meta', j.company + (j.location ? ' · ' + j.location : '')));
          var t = el('div', 'tags');
          if (j.fitsMay === true) t.appendChild(tag('Starts ' + j.startLabel + ' ✓', 'good'));
          else if (j.fitsMay === false) t.appendChild(tag('Starts ' + j.startLabel + ' (not May 2027)', 'warn'));
          else t.appendChild(tag('Start date not listed', 'warn'));
          if (j.bc) t.appendChild(tag('BC', 'good')); else t.appendChild(tag('Outside BC'));
          if (j.solidworks) t.appendChild(tag('SolidWorks', 'good'));
          if (j.source === 'manual') t.appendChild(tag('Hand-picked'));
          if (j.posted) t.appendChild(tag('Posted ' + j.posted));
          c.appendChild(t);
          if (j.source === 'manual' && j.note) c.appendChild(el('p', 'note', j.note));
          c.appendChild(actionsRow(j.id, false));
          return c;
        }

        function renderTabs() {
          var counts = { review: 0, shortlist: 0, applied: 0, skip: 0 };
          jobs.forEach(function (j) { var s = stateOf(j.id); counts[s || 'review']++; });
          var btns = $('tabs').querySelectorAll('button');
          for (var i = 0; i < btns.length; i++) {
            var t = btns[i].getAttribute('data-tab');
            btns[i].setAttribute('aria-pressed', t === tab ? 'true' : 'false');
            btns[i].querySelector('.n').textContent = '(' + counts[t] + ')';
          }
        }

        function renderStatus() {
          var s = $('status');
          s.textContent = '';
          var msg = link === 'online' ? 'Shared list connected.'
            : link === 'connecting' ? 'Connecting to the shared list…'
            : link === 'offline' ? 'Shared list unreachable right now. Marks are kept on this device.'
            : 'Marks are saved on this device only (shared list not set up yet).';
          s.appendChild(el('span', null, msg));
          if (who) s.appendChild(el('span', null, 'Marking as ' + who + '.'));
          var b = el('button', null, who ? 'Change name or passcode' : 'Set your name');
          b.type = 'button';
          b.addEventListener('click', function () { openSetup(null); });
          s.appendChild(b);
          if (flashMsg) { var m = el('span', null, flashMsg); m.style.color = 'var(--bad)'; s.appendChild(m); }
        }

        function renderJobs() {
          var q = $('q').value.trim().toLowerCase();
          var region = $('region').value, sw = $('sw').checked, mm = $('mismatch').checked;
          var shown = jobs.filter(function (j) {
            var s = stateOf(j.id) || 'review';
            if (s !== tab) return false;
            if (!mm && j.fitsMay === false) return false;
            if (sw && !j.solidworks) return false;
            if (region === 'bc' && !j.bc) return false;
            if (region === 'other' && j.bc) return false;
            if (q && (j.title + ' ' + j.company + ' ' + j.location).toLowerCase().indexOf(q) === -1) return false;
            return true;
          });
          list.textContent = '';
          shown.forEach(function (j) { list.appendChild(card(j)); });
          if (!shown.length) {
            var msg = tab === 'review'
              ? 'Nothing left to review with these filters. Try "Show other start dates", or check the employer list below.'
              : 'Nothing here yet.';
            list.appendChild(el('div', 'empty', msg));
          }
          var inTab = jobs.filter(function (j) { return (stateOf(j.id) || 'review') === tab; }).length;
          var hidden = inTab - shown.length;
          count.textContent = shown.length + ' shown' + (hidden ? ' · ' + hidden + ' hidden by filters' : '');
        }

        function renderEmployers() {
          var cos = document.querySelectorAll('.co[data-id]');
          for (var i = 0; i < cos.length; i++) {
            var node = cos[i];
            var old = node.querySelector('.actions');
            if (old) node.removeChild(old);
            node.appendChild(actionsRow(node.getAttribute('data-id'), true));
          }
        }

        function renderAll() { renderTabs(); renderStatus(); renderJobs(); renderEmployers(); }

        $('tabs').addEventListener('click', function (e) {
          var b = e.target.closest('button[data-tab]');
          if (!b) return;
          tab = b.getAttribute('data-tab');
          renderAll();
        });
        ['q', 'region', 'sw', 'mismatch'].forEach(function (id) {
          $(id).addEventListener(id === 'q' ? 'input' : 'change', renderJobs);
        });

        function showView(v) {
          if (v !== 'jobs' && v !== 'bc' && v !== 'else') v = 'jobs';
          var secs = document.querySelectorAll('.view');
          for (var i = 0; i < secs.length; i++) secs[i].hidden = secs[i].getAttribute('data-view') !== v;
          var nb = $('nav').querySelectorAll('button');
          for (var k = 0; k < nb.length; k++) nb[k].setAttribute('aria-pressed', nb[k].getAttribute('data-view') === v ? 'true' : 'false');
        }
        $('nav').addEventListener('click', function (e) {
          var b = e.target.closest('button[data-view]');
          if (!b) return;
          var v = b.getAttribute('data-view');
          showView(v);
          try { history.replaceState(null, '', '#' + v); } catch (err) {}
        });
        showView((location.hash || '').slice(1));

        renderAll();
        syncDown();
        document.addEventListener('visibilitychange', function () { if (!document.hidden) syncDown(); });
        if (API) setInterval(syncDown, 60000);
      })();
    </script>
  </body>
</html>
